package views

import "templcn/ui"

const homeTitle = "The Foundation for your Design System"
const homeDescription = "A set of beautifully designed components that you can customize, extend, and build on. Start here then make it your own. Open Source. Open Code."

templ Index() {
	@Page("templcn/ui") {
		<div class="group/layout relative z-10 flex min-h-svh flex-col bg-background">
			<header class="sticky top-0 z-50 w-full bg-background">
				<div class="container-wrapper px-6">
					<div class="container flex h-(--header-height) items-center">
						<a href="/" class="hidden size-8 items-center justify-center rounded-md text-foreground hover:bg-accent hover:text-accent-foreground lg:flex" aria-label="templcn/ui">
							<span class="text-sm font-semibold">T</span>
						</a>
						<nav class="hidden items-center gap-0.5 lg:flex">
							<a href="/docs" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground">Docs</a>
							<a href="/docs/components" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground">Components</a>
							<a href="/blocks" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground">Blocks</a>
							<a href="/charts" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground">Charts</a>
							<a href="/docs/directory" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground">Directory</a>
						</nav>
						<a href="/" class="flex items-center gap-2 lg:hidden">
							<span class="flex size-8 items-center justify-center rounded-md border border-border text-sm font-semibold">T</span>
							<span class="text-sm font-semibold">templcn/ui</span>
						</a>
						<div class="ml-auto flex items-center gap-2 md:flex-1 md:justify-end">
							<button type="button" aria-label="Search documentation" class="hidden h-8 min-w-48 items-center justify-between rounded-md border border-border bg-background px-2.5 text-sm text-muted-foreground shadow-xs md:flex">
								<span>Search documentation...</span>
								<kbd class="pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground opacity-100">⌘K</kbd>
							</button>
							<div class="hidden h-4 w-px bg-border lg:block"></div>
							<a href="https://github.com/davidojo/templcn" class="inline-flex size-8 items-center justify-center rounded-md text-sm font-medium hover:bg-accent hover:text-accent-foreground" aria-label="GitHub">
								<span>GH</span>
							</a>
							<div class="h-4 w-px bg-border"></div>
							@ThemeMenu()
							<div class="h-4 w-px bg-border"></div>
							@ui.Button(ui.ButtonProps{
								Label:   "New",
								Variant: ui.ButtonVariantDefault,
								Size:    ui.ButtonSizeSM,
								Href:    "/create",
								DOMProps: ui.DOMProps{
									Class: "h-[31px] rounded-lg shadow-none",
								},
							})
						</div>
					</div>
				</div>
			</header>

			<main class="flex min-h-0 flex-1 flex-col">
				<section class="border-grid">
					<div class="container-wrapper">
						<div class="container flex flex-col items-center gap-2 px-6 pb-10 pt-8 text-center md:pb-12 md:pt-10 xl:gap-3">
							@ui.Badge(ui.BadgeProps{
								Label:   "New preset commands",
								Variant: ui.BadgeVariantSecondary,
								Href:    "/docs/changelog",
								DOMProps: ui.DOMProps{
									Class: "bg-muted",
								},
							})
							<h1 class="leading-tighter max-w-3xl text-balance text-3xl font-semibold tracking-tight text-primary lg:leading-[1.1] xl:text-5xl">
								{ homeTitle }
							</h1>
							<p class="max-w-2xl text-balance text-base text-foreground sm:text-lg">
								{ homeDescription }
							</p>
							<div class="flex w-full items-center justify-center gap-2 pt-2">
								@ui.Button(ui.ButtonProps{
									Label:   "New Project",
									Variant: ui.ButtonVariantDefault,
									Size:    ui.ButtonSizeSM,
									Href:    "/create",
									DOMProps: ui.DOMProps{
										Class: "h-[31px] rounded-lg shadow-none",
									},
								})
								@ui.Button(ui.ButtonProps{
									Label:   "View Components",
									Variant: ui.ButtonVariantGhost,
									Size:    ui.ButtonSizeSM,
									Href:    "/docs/components",
									DOMProps: ui.DOMProps{
										Class: "rounded-lg shadow-none",
									},
								})
							</div>
						</div>
					</div>
				</section>

				<div class="container-wrapper flex-1 pb-10 pt-2">
					<div class="container overflow-hidden">
						<section class="theme-container">
							@HomeComponentGrid()
						</section>
					</div>
				</div>
			</main>
		</div>
	}
}

templ HomeComponentGrid() {
	<div class="mx-auto grid max-w-5xl gap-5 px-6 py-1 theme-container md:grid-cols-2 lg:grid-cols-4">
		<div class="flex flex-col gap-5">
			@ui.Card(ui.DOMProps{}) {
				@ui.CardHeader(ui.DOMProps{}) {
					@ui.CardTitle(ui.DOMProps{}) { <span>Field</span> }
					@ui.CardDescription(ui.DOMProps{}) { <span>Build forms with labels and help text.</span> }
				}
				@ui.CardContent(ui.DOMProps{Class: "grid gap-3"}) {
					<div class="grid gap-2">
						@ui.Label(ui.LabelProps{For: "home-email"}) { <span>Email</span> }
						@ui.Input(ui.InputProps{DOMProps: ui.DOMProps{ID: "home-email"}, Placeholder: "m@example.com"})
					</div>
					<p class="text-sm text-muted-foreground">Enter the email address for notifications.</p>
				}
			}
			@ui.Card(ui.DOMProps{}) {
				@ui.CardContent(ui.DOMProps{Class: "grid gap-4 p-4"}) {
					<div class="flex items-center justify-between gap-4">
						<div class="space-y-1">
							<p class="text-sm font-medium leading-none">Notifications</p>
							<p class="text-xs text-muted-foreground">Email updates</p>
						</div>
						@ui.Switch(ui.SwitchProps{Checked: true})
					</div>
					@ui.Separator(ui.SeparatorProps{})
					<div class="flex items-center justify-between gap-4">
						<div class="space-y-1">
							<p class="text-sm font-medium leading-none">Marketing</p>
							<p class="text-xs text-muted-foreground">Product news</p>
						</div>
						@ui.Switch(ui.SwitchProps{})
					</div>
				}
			}
		</div>
		<div class="flex flex-col gap-5">
			@ui.Card(ui.DOMProps{}) {
				@ui.CardContent(ui.DOMProps{Class: "grid gap-4 p-4"}) {
					<div class="flex items-center gap-3">
						@ui.Avatar(ui.AvatarProps{}) {
							@ui.AvatarFallback(ui.DOMProps{}) { <span>SD</span> }
						}
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-medium leading-none">Sofia Davis</p>
							<p class="truncate text-xs text-muted-foreground">m@example.com</p>
						</div>
					</div>
					<div class="flex -space-x-2">
						@ui.Avatar(ui.AvatarProps{Size: "sm"}) { @ui.AvatarFallback(ui.DOMProps{}) { <span>JL</span> } }
						@ui.Avatar(ui.AvatarProps{Size: "sm"}) { @ui.AvatarFallback(ui.DOMProps{}) { <span>IN</span> } }
						@ui.Avatar(ui.AvatarProps{Size: "sm"}) { @ui.AvatarFallback(ui.DOMProps{}) { <span>OM</span> } }
					</div>
				}
			}
			@ui.Card(ui.DOMProps{}) {
				@ui.CardContent(ui.DOMProps{Class: "grid gap-3 p-4"}) {
					<div class="flex items-center justify-between">
						<p class="text-sm font-medium">Deployments</p>
						@ui.Badge(ui.BadgeProps{Label: "Live", Variant: ui.BadgeVariantSecondary})
					</div>
					@ui.Progress(ui.ProgressProps{Value: 72, Max: 100})
					<p class="text-xs text-muted-foreground">72% complete</p>
				}
			}
		</div>
		<div class="flex flex-col gap-5">
			@ui.Card(ui.DOMProps{}) {
				@ui.CardHeader(ui.DOMProps{}) {
					@ui.CardTitle(ui.DOMProps{}) { <span>Appearance</span> }
				}
				@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
					<div class="grid gap-2">
						@ui.Label(ui.LabelProps{}) { <span>Accent</span> }
						@ui.ToggleGroup(ui.ToggleGroupProps{Type: "single", Variant: "outline", Size: "sm"}) {
							@ui.ToggleGroupItem(ui.ToggleGroupItemProps{Value: "zinc"}) { <span>Zinc</span> }
							@ui.ToggleGroupItem(ui.ToggleGroupItemProps{Value: "slate"}) { <span>Slate</span> }
							@ui.ToggleGroupItem(ui.ToggleGroupItemProps{Value: "stone"}) { <span>Stone</span> }
						}
					</div>
					@ui.Slider(ui.SliderProps{Value: []float64{64}, Max: 100})
				}
			}
			@ui.Card(ui.DOMProps{}) {
				@ui.CardContent(ui.DOMProps{Class: "grid gap-3 p-4"}) {
					<div class="flex flex-wrap gap-2">
						@ui.Badge(ui.BadgeProps{Label: "Registry", Variant: ui.BadgeVariantOutline})
						@ui.Badge(ui.BadgeProps{Label: "Blocks", Variant: ui.BadgeVariantSecondary})
					</div>
					@ui.Alert(ui.AlertProps{}) {
						@ui.AlertTitle(ui.DOMProps{}) { <span>Heads up</span> }
						@ui.AlertDescription(ui.DOMProps{}) { <span>Add components from any registry.</span> }
					}
				}
			}
		</div>
		<div class="flex flex-col gap-5">
			@ui.Card(ui.DOMProps{}) {
				@ui.CardHeader(ui.DOMProps{}) {
					@ui.CardTitle(ui.DOMProps{}) { <span>Prompt</span> }
				}
				@ui.CardContent(ui.DOMProps{Class: "grid gap-3"}) {
					@ui.Textarea(ui.TextareaProps{Placeholder: "Create a settings form with tabs..."})
					<div class="flex justify-end">
						@ui.Button(ui.ButtonProps{Label: "Generate", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
					</div>
				}
			}
			@ui.Card(ui.DOMProps{}) {
				@ui.CardContent(ui.DOMProps{Class: "grid gap-4 p-4"}) {
					<div class="flex items-center gap-3">
						@ui.Checkbox(ui.CheckboxProps{Checked: true})
						<p class="min-w-0 flex-1 text-sm">Use server-rendered components</p>
					</div>
					<div class="flex items-center gap-3">
						@ui.Checkbox(ui.CheckboxProps{})
						<p class="min-w-0 flex-1 text-sm">Install blocks from registry</p>
					</div>
				}
			}
		</div>
	</div>
}

templ HomeMember(initials string, name string, email string) {
	<div class="flex items-center gap-4">
		@ui.Avatar(ui.AvatarProps{}) {
			@ui.AvatarFallback(ui.DOMProps{}) { <span>{ initials }</span> }
		}
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium leading-none">{ name }</p>
			<p class="truncate text-sm text-muted-foreground">{ email }</p>
		</div>
		@ui.Button(ui.ButtonProps{Label: "View", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
	</div>
}
