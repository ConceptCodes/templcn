}

// ─── Toggle ──────────────────────────────────────────────────────────────────

templ TogglePreview() {
	<div class="flex flex-wrap gap-3">
		@ui.Toggle(ui.ToggleProps{}) { <span>Bold</span> }
		@ui.Toggle(ui.ToggleProps{Pressed: true}) { <span>Italic</span> }
		@ui.Toggle(ui.ToggleProps{Variant: "outline"}) { <span>Outline</span> }
		@ui.Toggle(ui.ToggleProps{Disabled: true}) { <span>Disabled</span> }
	</div>
}

// ─── Typography ──────────────────────────────────────────────────────────────

templ TypographyPreview() {
	<div class="grid gap-3 max-w-sm">
		@ui.H1(ui.DOMProps{}) { <span>Heading 1</span> }
		@ui.H2(ui.DOMProps{}) { <span>Heading 2</span> }
		@ui.H3(ui.DOMProps{}) { <span>Heading 3</span> }
		@ui.P(ui.DOMProps{}) { <span>This is a paragraph of body text.</span> }
		@ui.Lead(ui.DOMProps{}) { <span>A lead paragraph, slightly larger.</span> }
		@ui.Muted(ui.DOMProps{}) { <span>Muted helper text appears here.</span> }
		@ui.InlineCode(ui.DOMProps{}) { <span>const x = 1</span> }
	</div>
}

