package views

import "templcn/ui"

// ─── Accordion ───────────────────────────────────────────────────────────────

templ AccordionPreview() {
	@ui.Accordion(ui.AccordionProps{Type: "single", Collapsible: true, DOMProps: ui.DOMProps{Class: "w-full max-w-md"}}) {
		@ui.AccordionItem(ui.AccordionItemProps{Value: "item-1"}) {
			@ui.AccordionTrigger(ui.DOMProps{}) {
				Is it accessible?
			}
			@ui.AccordionContent(ui.DOMProps{}) {
				Yes. It adheres to the WAI-ARIA design pattern.
			}
		}
		@ui.AccordionItem(ui.AccordionItemProps{Value: "item-2"}) {
			@ui.AccordionTrigger(ui.DOMProps{}) {
				Is it styled?
			}
			@ui.AccordionContent(ui.DOMProps{}) {
				Yes. It comes with default styles that match the other components.
			}
		}
		@ui.AccordionItem(ui.AccordionItemProps{Value: "item-3"}) {
			@ui.AccordionTrigger(ui.DOMProps{}) {
				Is it animated?
			}
			@ui.AccordionContent(ui.DOMProps{}) {
				Yes. It uses the CSS details/summary element for native animation.
			}
		}
	}
}

// ─── Alert ───────────────────────────────────────────────────────────────────

templ AlertDefaultPreview() {
	@ui.Alert(ui.AlertProps{}) {
		@ui.AlertTitle(ui.DOMProps{}) { Heads up! }
		@ui.AlertDescription(ui.DOMProps{}) {
			You can add components to your app using the templcn CLI.
		}
	}
}

templ AlertDestructivePreview() {
	@ui.Alert(ui.AlertProps{Variant: ui.AlertVariantDestructive}) {
		@ui.AlertTitle(ui.DOMProps{}) { Error }
		@ui.AlertDescription(ui.DOMProps{}) {
			Your session has expired. Please log in again.
		}
	}
}

// ─── Badge ───────────────────────────────────────────────────────────────────

templ BadgePreview() {
	<div class="flex flex-wrap gap-3 items-center">
		@ui.Badge(ui.BadgeProps{Label: "Default"})
		@ui.Badge(ui.BadgeProps{Label: "Secondary", Variant: ui.BadgeVariantSecondary})
		@ui.Badge(ui.BadgeProps{Label: "Outline", Variant: ui.BadgeVariantOutline})
		@ui.Badge(ui.BadgeProps{Label: "Destructive", Variant: ui.BadgeVariantDestructive})
		@ui.Badge(ui.BadgeProps{Label: "Ghost", Variant: ui.BadgeVariantGhost})
	</div>
}

// ─── Button ───────────────────────────────────────────────────────────────────

templ ButtonVariantsPreview() {
	<div class="flex flex-wrap gap-3 items-center">
		@ui.Button(ui.ButtonProps{Label: "Default"})
		@ui.Button(ui.ButtonProps{Label: "Secondary", Variant: ui.ButtonVariantSecondary})
		@ui.Button(ui.ButtonProps{Label: "Outline", Variant: ui.ButtonVariantOutline})
		@ui.Button(ui.ButtonProps{Label: "Ghost", Variant: ui.ButtonVariantGhost})
		@ui.Button(ui.ButtonProps{Label: "Link", Variant: ui.ButtonVariantLink})
		@ui.Button(ui.ButtonProps{Label: "Destructive", Variant: ui.ButtonVariantDestructive})
	</div>
}

templ ButtonSizesPreview() {
	<div class="flex flex-wrap gap-3 items-center">
		@ui.Button(ui.ButtonProps{Label: "Extra Small", Size: ui.ButtonSizeXS})
		@ui.Button(ui.ButtonProps{Label: "Small", Size: ui.ButtonSizeSM})
		@ui.Button(ui.ButtonProps{Label: "Default"})
		@ui.Button(ui.ButtonProps{Label: "Large", Size: ui.ButtonSizeLG})
	</div>
}

templ ButtonDisabledPreview() {
	@ui.Button(ui.ButtonProps{Label: "Disabled", Disabled: true})
}

// ─── Card ────────────────────────────────────────────────────────────────────

templ CardPreview() {
	@ui.Card(ui.DOMProps{Class: "w-80"}) {
		@ui.CardHeader(ui.DOMProps{}) {
			@ui.CardTitle(ui.DOMProps{}) { <span>Create project</span> }
			@ui.CardDescription(ui.DOMProps{}) { <span>Deploy your new project in one-click.</span> }
		}
		@ui.CardContent(ui.DOMProps{}) {
			<div class="grid gap-3">
				@ui.Label(ui.LabelProps{For: "card-name"}) { <span>Name</span> }
				@ui.Input(ui.InputProps{Placeholder: "Name of your project"})
			</div>
		}
		@ui.CardFooter(ui.DOMProps{}) {
			<div class="flex gap-2 w-full">
				@ui.Button(ui.ButtonProps{Label: "Cancel", Variant: ui.ButtonVariantOutline})
				@ui.Button(ui.ButtonProps{Label: "Deploy"})
			</div>
		}
	}
}

// ─── Checkbox ────────────────────────────────────────────────────────────────

templ CheckboxPreview() {
	<div class="flex flex-col gap-3">
		<div class="flex items-center gap-2">
			@ui.Checkbox(ui.CheckboxProps{Name: "terms"})
			<label class="text-sm font-medium leading-none">Accept terms and conditions</label>
		</div>
		<div class="flex items-center gap-2">
			@ui.Checkbox(ui.CheckboxProps{Name: "disabled", Disabled: true})
			<label class="text-sm font-medium leading-none text-muted-foreground">Disabled</label>
		</div>
		<div class="flex items-center gap-2">
			@ui.Checkbox(ui.CheckboxProps{Name: "checked", Checked: true})
			<label class="text-sm font-medium leading-none">Already checked</label>
		</div>
	</div>
}

// ─── Input ───────────────────────────────────────────────────────────────────

templ InputPreview() {
	<div class="w-full max-w-sm grid gap-3">
		@ui.Input(ui.InputProps{Placeholder: "Email"})
		@ui.Input(ui.InputProps{Type: "password", Placeholder: "Password"})
		@ui.Input(ui.InputProps{Placeholder: "Disabled", Disabled: true})
	</div>
}

// ─── Label ───────────────────────────────────────────────────────────────────

templ LabelPreview() {
	<div class="grid gap-2 w-full max-w-sm">
		@ui.Label(ui.LabelProps{For: "label-email"}) { <span>Your email address</span> }
		@ui.Input(ui.InputProps{DOMProps: ui.DOMProps{ID: "label-email"}, Placeholder: "name@example.com"})
	</div>
}

// ─── Separator ───────────────────────────────────────────────────────────────

templ SeparatorPreview() {
	<div class="w-full max-w-sm grid gap-4">
		<div>
			<p class="text-sm font-medium">templcn/ui</p>
			<p class="text-sm text-muted-foreground">An open-source UI component library.</p>
		</div>
		@ui.Separator(ui.SeparatorProps{})
		<div class="flex gap-4 text-sm">
			<span>Blog</span>
			@ui.Separator(ui.SeparatorProps{Orientation: ui.SeparatorOrientationVertical, DOMProps: ui.DOMProps{Class: "h-4"}})
			<span>Docs</span>
			@ui.Separator(ui.SeparatorProps{Orientation: ui.SeparatorOrientationVertical, DOMProps: ui.DOMProps{Class: "h-4"}})
			<span>Source</span>
		</div>
	</div>
}

// ─── Skeleton ────────────────────────────────────────────────────────────────

templ SkeletonPreview() {
	<div class="flex items-center gap-4 w-72">
		@ui.Skeleton(ui.DOMProps{Class: "size-12 rounded-full"})
		<div class="grid gap-2 flex-1">
			@ui.Skeleton(ui.DOMProps{Class: "h-4 w-full"})
			@ui.Skeleton(ui.DOMProps{Class: "h-4 w-3/4"})
		</div>
	</div>
}

