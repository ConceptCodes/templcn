templ ButtonGroupPreview() {
	@ui.ButtonGroup(ui.ButtonGroupProps{}) {
		@ui.Button(ui.ButtonProps{Label: "Left", Variant: ui.ButtonVariantOutline, DOMProps: ui.DOMProps{Class: "rounded-r-none"}})
		@ui.ButtonGroupSeparator(ui.DOMProps{})
		@ui.Button(ui.ButtonProps{Label: "Center", Variant: ui.ButtonVariantOutline, DOMProps: ui.DOMProps{Class: "rounded-none"}})
		@ui.ButtonGroupSeparator(ui.DOMProps{})
		@ui.Button(ui.ButtonProps{Label: "Right", Variant: ui.ButtonVariantOutline, DOMProps: ui.DOMProps{Class: "rounded-l-none"}})
	}
}

