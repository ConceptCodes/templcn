// ─── NativeSelect ────────────────────────────────────────────────────────────

templ NativeSelectPreview() {
	<div class="w-full max-w-xs">
		@ui.NativeSelect(ui.NativeSelectProps{}) {
			@ui.NativeSelectOption(ui.DOMProps{}, "apple", "Apple", false)
			@ui.NativeSelectOption(ui.DOMProps{}, "banana", "Banana", true)
			@ui.NativeSelectOption(ui.DOMProps{}, "cherry", "Cherry", false)
		}
	</div>
}

// ─── RadioGroup ──────────────────────────────────────────────────────────────

templ RadioGroupPreview() {
	@ui.RadioGroup(ui.RadioGroupProps{Name: "plan", DefaultValue: "starter"}) {
		@ui.RadioGroupItem(ui.RadioGroupItemProps{Name: "plan", Value: "starter", Label: "Starter"})
		@ui.RadioGroupItem(ui.RadioGroupItemProps{Name: "plan", Value: "pro", Label: "Pro"})
		@ui.RadioGroupItem(ui.RadioGroupItemProps{Name: "plan", Value: "enterprise", Label: "Enterprise"})
	}
}

// ─── Slider ──────────────────────────────────────────────────────────────────

templ SliderPreview() {
	<div class="w-full max-w-sm grid gap-4">
		@ui.Slider(ui.SliderProps{Min: 0, Max: 100, DefaultValue: []float64{40}})
		@ui.Slider(ui.SliderProps{Min: 0, Max: 100, DefaultValue: []float64{20, 70}})
	</div>
}

// ─── Pagination ──────────────────────────────────────────────────────────────

templ PaginationPreview() {
	@ui.Pagination(ui.DOMProps{}) {
		@ui.PaginationContent(ui.DOMProps{}) {
			@ui.PaginationItem(ui.DOMProps{}) {
				@ui.PaginationPrevious(ui.PaginationLinkProps{Href: "#"}) { <span>Previous</span> }
			}
			@ui.PaginationItem(ui.DOMProps{}) {
				@ui.PaginationLink(ui.PaginationLinkProps{Href: "#", IsActive: true}) { <span>1</span> }
			}
			@ui.PaginationItem(ui.DOMProps{}) {
				@ui.PaginationLink(ui.PaginationLinkProps{Href: "#"}) { <span>2</span> }
			}
			@ui.PaginationItem(ui.DOMProps{}) {
				@ui.PaginationLink(ui.PaginationLinkProps{Href: "#"}) { <span>3</span> }
			}
			@ui.PaginationItem(ui.DOMProps{}) {
				@ui.PaginationEllipsis(ui.DOMProps{}) { <span>···</span> }
			}
			@ui.PaginationItem(ui.DOMProps{}) {
				@ui.PaginationNext(ui.PaginationLinkProps{Href: "#"}) { <span>Next</span> }
			}
		}
	}
}

