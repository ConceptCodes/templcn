			@ui.BreadcrumbItem(ui.DOMProps{}) {
				@ui.BreadcrumbLink(ui.BreadcrumbLinkProps{Href: "/components"}) { <span>Components</span> }
			}
			@ui.BreadcrumbSeparator(ui.DOMProps{}) { <span>/</span> }
			@ui.BreadcrumbItem(ui.DOMProps{}) {
				@ui.BreadcrumbPage(ui.DOMProps{}) { <span>Breadcrumb</span> }
			}
		}
	}
}

