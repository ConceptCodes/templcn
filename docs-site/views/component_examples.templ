templ ProgressPreview() {
	<div class="w-full max-w-sm grid gap-4">
		@ui.Progress(ui.ProgressProps{Value: 20})
		@ui.Progress(ui.ProgressProps{Value: 60})
		@ui.Progress(ui.ProgressProps{Value: 100})
	</div>
}

