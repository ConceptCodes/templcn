templ TextareaPreview() {
	<div class="w-full max-w-sm grid gap-3">
		@ui.Textarea(ui.TextareaProps{Placeholder: "Type your message here."})
		@ui.Textarea(ui.TextareaProps{Placeholder: "Disabled", Disabled: true})
	</div>
}

// ─── Switch ──────────────────────────────────────────────────────────────────

templ SwitchPreview() {
	<div class="flex flex-col gap-3">
		<div class="flex items-center gap-2">
			@ui.Switch(ui.SwitchProps{Name: "notifications"})
			<label class="text-sm font-medium">Airplane Mode</label>
		</div>
		<div class="flex items-center gap-2">
			@ui.Switch(ui.SwitchProps{Name: "active", Checked: true})
			<label class="text-sm font-medium">Notifications</label>
		</div>
	</div>
}

// ─── Tabs ────────────────────────────────────────────────────────────────────

templ TabsPreview() {
	@ui.Tabs(ui.TabsProps{DefaultValue: "account", DOMProps: ui.DOMProps{Class: "w-full max-w-sm"}}) {
		@ui.TabsList(ui.TabsListProps{}) {
			@ui.TabsTrigger(ui.TabsTriggerProps{Value: "account", Active: true}) { <span>Account</span> }
			@ui.TabsTrigger(ui.TabsTriggerProps{Value: "password"}) { <span>Password</span> }
		}
		@ui.TabsContent(ui.TabsContentProps{Value: "account", Active: true}) {
			<p class="text-sm text-muted-foreground p-4">Make changes to your account here.</p>
		}
		@ui.TabsContent(ui.TabsContentProps{Value: "password"}) {
			<p class="text-sm text-muted-foreground p-4">Change your password here.</p>
		}
	}
}

// ─── Collapsible ─────────────────────────────────────────────────────────────

templ CollapsiblePreview() {
	@ui.Collapsible(ui.CollapsibleProps{DOMProps: ui.DOMProps{Class: "w-full max-w-sm"}}) {
		@ui.CollapsibleTrigger(ui.DOMProps{}) {
			<div class="flex items-center justify-between rounded-md border p-3 cursor-pointer hover:bg-accent">
				<p class="text-sm font-medium">{ "@tanstack/react-query" }</p>
				<span class="text-xs text-muted-foreground">Expand</span>
			</div>
		}
		@ui.CollapsibleContent(ui.DOMProps{}) {
			<div class="rounded-md border p-3 mt-1 text-sm text-muted-foreground">
				A powerful data synchronization library for React.
			</div>
		}
	}
}

// ─── Accordion ── (second full preview with variant) ─────────────────────────

templ AccordionMultiplePreview() {
	@ui.Accordion(ui.AccordionProps{Type: "multiple", DOMProps: ui.DOMProps{Class: "w-full max-w-md"}}) {
		@ui.AccordionItem(ui.AccordionItemProps{Value: "a"}) {
			@ui.AccordionTrigger(ui.DOMProps{}) { What is templcn/ui? }
			@ui.AccordionContent(ui.DOMProps{}) {
				A set of accessible, customizable components built on Radix UI and Tailwind CSS.
			}
		}
		@ui.AccordionItem(ui.AccordionItemProps{Value: "b"}) {
			@ui.AccordionTrigger(ui.DOMProps{}) { Is it open source? }
			@ui.AccordionContent(ui.DOMProps{}) {
				Yes. The source code is available on GitHub.
			}
		}
	}
}

