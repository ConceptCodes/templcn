package views

import (
	t "github.com/a-h/templ"
	"shadcn/ui"
)

templ SiteHeader() {
	<header class="sticky top-0 z-50 w-full border-b border-border/70 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/75">
		<div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-6">
			<a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
				<span class="flex size-7 items-center justify-center rounded-md bg-primary text-xs text-primary-foreground">S</span>
				<span class="text-sm">shadcn/ui</span>
			</a>
			<nav class="hidden items-center gap-1 lg:flex">
				@ui.Button(ui.ButtonProps{Label: "Docs", Variant: ui.ButtonVariantGhost, Size: ui.ButtonSizeSM, Href: "/docs/installation"})
				@ui.Button(ui.ButtonProps{Label: "Components", Variant: ui.ButtonVariantGhost, Size: ui.ButtonSizeSM, Href: "/docs/components"})
				@ui.Button(ui.ButtonProps{Label: "Blocks", Variant: ui.ButtonVariantGhost, Size: ui.ButtonSizeSM, Href: "/blocks"})
				@ui.Button(ui.ButtonProps{Label: "Charts", Variant: ui.ButtonVariantGhost, Size: ui.ButtonSizeSM, Href: "/charts/area"})
				@ui.Button(ui.ButtonProps{Label: "Directory", Variant: ui.ButtonVariantGhost, Size: ui.ButtonSizeSM, Href: "/docs/directory"})
				@ui.Button(ui.ButtonProps{Label: "Create", Variant: ui.ButtonVariantGhost, Size: ui.ButtonSizeSM, Href: "/create"})
			</nav>
			<div class="ml-auto flex items-center gap-2">
				<a href="https://github.com/shadcn-ui/ui" class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
					<span class="hidden sm:inline">GitHub</span>
				</a>
				<button data-theme-toggle="true" class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
					<span class="hidden sm:inline">Theme</span>
				</button>
			</div>
		</div>
	</header>
}

templ SiteFooter() {
	<footer class="border-t border-border/70 py-6 md:py-0">
		<div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-4 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
			<p>Built by <a class="underline-offset-4 hover:underline" href="https://twitter.com/shadcn">shadcn</a> at <a class="underline-offset-4 hover:underline" href="https://vercel.com">Vercel</a>.</p>
			<p>The source code is available on <a class="underline-offset-4 hover:underline" href="https://github.com/shadcn-ui/ui">GitHub</a>.</p>
		</div>
	</footer>
}

templ DocsLayout(title string, active string) {
	@Page(title) {
		@SiteHeader()
		<div class="min-h-svh bg-background">
			<!-- Mobile menu toggle button -->
			<button
				data-mobile-menu-toggle="true"
				class="lg:hidden sticky top-14 z-40 mx-6 mt-4 flex items-center gap-2 rounded-md border border-border/70 bg-background px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
				<span>Menu</span>
			</button>

			<!-- Mobile drawer overlay -->
			<div
				data-mobile-drawer="true"
				class="hidden fixed inset-0 z-50 bg-background/95 backdrop-blur lg:hidden"
			>
				<div class="flex h-full flex-col">
					<div class="flex items-center justify-between border-b border-border/70 px-6 py-4">
						<a href="/" class="inline-flex items-center gap-2 font-semibold tracking-tight">
							<span class="flex size-7 items-center justify-center rounded-md bg-primary text-xs text-primary-foreground">S</span>
							<span>shadcn/ui</span>
						</a>
						<button
							data-mobile-drawer-close="true"
							class="rounded-md p-2 text-muted-foreground hover:text-foreground"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
						</button>
					</div>
					<div class="flex-1 overflow-auto px-6 py-6">
						<nav class="grid gap-1 text-sm">
							<a href="/docs" class={ SectionLinkClass(active, "docs") }>Introduction</a>
							<a href="/docs/installation" class={ SectionLinkClass(active, "installation") }>Installation</a>
							<a href="/docs/theming" class={ SectionLinkClass(active, "theming") }>Theming</a>
							<a href="/docs/cli" class={ SectionLinkClass(active, "cli") }>CLI</a>
							<a href="/docs/rtl" class={ SectionLinkClass(active, "rtl") }>RTL</a>
							<a href="/docs/skills" class={ SectionLinkClass(active, "skills") }>Skills</a>
							<a href="/docs/mcp" class={ SectionLinkClass(active, "mcp") }>MCP Server</a>
							<a href="/docs/registry" class={ SectionLinkClass(active, "registry") }>Registry</a>
							<a href="/docs/forms" class={ SectionLinkClass(active, "forms") }>Forms</a>
							<a href="/docs/changelog" class={ SectionLinkClass(active, "changelog") }>Changelog</a>
							<a href="/docs/directory" class={ SectionLinkClass(active, "directory") }>Directory</a>
						</nav>

						<div class="mt-6 space-y-2">
							<p class="text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground">Components</p>
							<div class="max-h-[32rem] overflow-auto pr-1">
								<div class="grid gap-1 text-sm">
									for _, doc := range ComponentIndex() {
										<a
											href={ t.SafeURL("/docs/components/" + doc.Slug) }
											class={ ComponentLinkClass(active, doc.Slug) }
										>
											{ doc.Title }
										</a>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="mx-auto flex min-h-svh max-w-7xl flex-col lg:flex-row">
				<aside class="hidden lg:block border-b border-border/70 px-6 py-6 lg:w-72 lg:border-r lg:border-b-0">
					<div class="space-y-6">
						<div class="space-y-2">
							<a href="/" class="inline-flex items-center gap-2 font-semibold tracking-tight">
								<span class="flex size-7 items-center justify-center rounded-md bg-primary text-xs text-primary-foreground">S</span>
								<span>shadcn/ui</span>
							</a>
							<p class="text-sm text-muted-foreground">Copy, paste, and adapt the source.</p>
						</div>

						<nav class="grid gap-1 text-sm">
							<a href="/docs" class={ SectionLinkClass(active, "docs") }>Introduction</a>
							<a href="/docs/installation" class={ SectionLinkClass(active, "installation") }>Installation</a>
							<a href="/docs/theming" class={ SectionLinkClass(active, "theming") }>Theming</a>
							<a href="/docs/cli" class={ SectionLinkClass(active, "cli") }>CLI</a>
							<a href="/docs/rtl" class={ SectionLinkClass(active, "rtl") }>RTL</a>
							<a href="/docs/skills" class={ SectionLinkClass(active, "skills") }>Skills</a>
							<a href="/docs/mcp" class={ SectionLinkClass(active, "mcp") }>MCP Server</a>
							<a href="/docs/registry" class={ SectionLinkClass(active, "registry") }>Registry</a>
							<a href="/docs/forms" class={ SectionLinkClass(active, "forms") }>Forms</a>
							<a href="/docs/changelog" class={ SectionLinkClass(active, "changelog") }>Changelog</a>
							<a href="/docs/directory" class={ SectionLinkClass(active, "directory") }>Directory</a>
						</nav>

						<div class="space-y-2">
							<p class="text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground">Components</p>
							<div class="max-h-[32rem] overflow-auto pr-1">
								<div class="grid gap-1 text-sm">
									for _, doc := range ComponentIndex() {
										<a
											href={ t.SafeURL("/docs/components/" + doc.Slug) }
											class={ ComponentLinkClass(active, doc.Slug) }
										>
											{ doc.Title }
										</a>
									}
								</div>
							</div>
						</div>
					</div>
				</aside>

				<main class="flex-1 px-6 py-10 lg:px-10">
					{ children... }
				</main>
			</div>
		</div>
		@SiteFooter()
		@SearchDialog()
	}
}

templ DocsIndexPage() {
	@DocsLayout("Introduction - shadcn/ui", "docs") {
		<div class="mx-auto flex max-w-4xl flex-col gap-10">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Introduction</p>
				<h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">A code distribution platform for Go and templ.</h1>
				<p class="max-w-2xl text-lg leading-8 text-muted-foreground">This mirror keeps the shadcn information architecture intact: landing page, blocks, docs, component pages, and the registry directory all land on the same routes a shadcn user expects.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the individual docs pages for each component.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="flex items-center gap-3">
							@ui.Button(ui.ButtonProps{Label: "Open components", Href: "/docs/components"})
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Blocks</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the prebuilt dashboard and auth layouts.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open blocks", Variant: ui.ButtonVariantOutline, Href: "/blocks"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Charts</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Chart docs and examples built around the same tokens.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open charts", Variant: ui.ButtonVariantOutline, Href: "/charts"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Directory</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the registry directory and community extensions.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open directory", Variant: ui.ButtonVariantOutline, Href: "/directory"})
					}
				}
			</section>

			<section class="grid gap-4 rounded-xl border border-border/70 bg-card p-6 shadow-sm">
				<div class="flex flex-col gap-2">
					<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Principles</p>
					<h2 class="text-2xl font-semibold tracking-tight">Open code, composition, distribution.</h2>
				</div>
				<div class="grid gap-3 md:grid-cols-3">
					<div class="rounded-lg border border-border/70 p-4">
						<p class="font-medium">Open code</p>
						<p class="mt-2 text-sm text-muted-foreground">Each component is a source file in the repo, not a sealed package.</p>
					</div>
					<div class="rounded-lg border border-border/70 p-4">
						<p class="font-medium">Composition</p>
						<p class="mt-2 text-sm text-muted-foreground">Every page is built from the same primitives the app consumes.</p>
					</div>
					<div class="rounded-lg border border-border/70 p-4">
						<p class="font-medium">Distribution</p>
						<p class="mt-2 text-sm text-muted-foreground">Routes, docs, and blocks are organized like the official shadcn site.</p>
					</div>
				</div>
			</section>
		</div>
	}
}

templ ComponentsIndexPage() {
	@DocsLayout("Components - shadcn/ui", "components") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Components</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Browse the component docs one page at a time.</h1>
				<p class="max-w-2xl text-lg leading-8 text-muted-foreground">This page mirrors the shadcn component index and links each component to its own detail page.</p>
			</section>

			<section class="grid gap-3">
				for _, doc := range ComponentIndex() {
					<a href={ t.SafeURL("/docs/components/" + doc.Slug) } class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
						<div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
							<div class="space-y-1">
								<div class="flex items-center gap-2">
									<h2 class="text-lg font-medium">{ doc.Title }</h2>
									@ui.Badge(ui.BadgeProps{Label: doc.Slug, Variant: ui.BadgeVariantOutline})
								</div>
								<p class="text-sm text-muted-foreground">{ doc.Description }</p>
							</div>
							<span class="text-sm text-muted-foreground transition-colors group-hover:text-foreground">{ doc.Install }</span>
						</div>
					</a>
				}
			</section>
		</div>
	}
}

templ ComponentDetailPage(doc ComponentDocEntry, prev ComponentDocEntry, hasPrev bool, next ComponentDocEntry, hasNext bool) {
	@DocsLayout("Component - "+doc.Title, "component-"+doc.Slug) {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Component", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: doc.Slug, Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{ doc.Title }</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">{ doc.Description }</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Installation</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<!-- Tabbed Install Section -->
						<div class="space-y-4">
							<div class="flex gap-2 border-b border-border/70 pb-2">
								<button
									id={ "tab-cli-btn-" + doc.Slug }
									data-slug={ doc.Slug }
									data-tab="cli"
									class="tab-btn px-3 py-1 text-sm font-medium text-foreground border-b-2 border-primary"
								>
									CLI
								</button>
								<button
									id={ "tab-manual-btn-" + doc.Slug }
									data-slug={ doc.Slug }
									data-tab="manual"
									class="tab-btn px-3 py-1 text-sm font-medium text-muted-foreground"
								>
									Manual
								</button>
							</div>
							<div id={ "tab-cli-" + doc.Slug } class="tab-content space-y-2">
								<p class="text-sm text-muted-foreground">Add this component to your Go project using the CLI.</p>
								<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ doc.Install }</code></pre>
							</div>
							<div id={ "tab-manual-" + doc.Slug } class="tab-content hidden space-y-2">
								<p class="text-sm text-muted-foreground">Manual installation steps for this component.</p>
								<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ doc.ManualInstall }</code></pre>
							</div>
						</div>
						<script>
						(function() &#123;
							var buttons = document.querySelectorAll('.tab-btn');
							buttons.forEach(function(btn) &#123;
								btn.addEventListener('click', function() &#123;
									var slug = this.getAttribute('data-slug');
									var tab = this.getAttribute('data-tab');
									var cliContent = document.getElementById('tab-cli-' + slug);
									var manualContent = document.getElementById('tab-manual-' + slug);
									var cliBtn = document.getElementById('tab-cli-btn-' + slug);
									var manualBtn = document.getElementById('tab-manual-btn-' + slug);
									
									if (tab === 'cli') &#123;
										cliContent.classList.remove('hidden');
										manualContent.classList.add('hidden');
										cliBtn.classList.add('border-b-2', 'border-primary', 'text-foreground');
										cliBtn.classList.remove('text-muted-foreground');
										manualBtn.classList.remove('border-b-2', 'border-primary', 'text-foreground');
										manualBtn.classList.add('text-muted-foreground');
									&#125; else &#123;
										manualContent.classList.remove('hidden');
										cliContent.classList.add('hidden');
										manualBtn.classList.add('border-b-2', 'border-primary', 'text-foreground');
										manualBtn.classList.remove('text-muted-foreground');
										cliBtn.classList.remove('border-b-2', 'border-primary', 'text-foreground');
										cliBtn.classList.add('text-muted-foreground');
									&#125;
								&#125;);
							&#125;);
						&#125;)();
						</script>
					}
				}

				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Usage</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ doc.GoUsage }</code></pre>
					}
				}

				if len(doc.Examples) > 0 {
					@ui.Card(ui.DOMProps{}) {
						@ui.CardHeader(ui.DOMProps{}) {
							@ui.CardTitle(ui.DOMProps{}) { <span>Examples</span> }
						}
						@ui.CardContent(ui.DOMProps{}) {
							<div class="space-y-4">
								for _, example := range doc.Examples {
									<div class="space-y-1">
										<h3 class="text-lg font-semibold">{ example.Name }</h3>
										<p class="text-sm text-muted-foreground">{ example.Desc }</p>
									</div>
								}
							</div>
						}
					}
				}

				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>API Reference</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						if len(doc.APIProps) > 0 {
							<div class="overflow-x-auto">
								<table class="w-full text-sm">
									<thead>
										<tr class="border-b border-border/70">
											<th class="px-4 py-2 text-left font-medium">Prop</th>
											<th class="px-4 py-2 text-left font-medium">Type</th>
											<th class="px-4 py-2 text-left font-medium">Default</th>
											<th class="px-4 py-2 text-left font-medium">Description</th>
										</tr>
									</thead>
									<tbody>
										for _, prop := range doc.APIProps {
											<tr class="border-b border-border/70">
												<td class="px-4 py-2 font-mono text-xs">{ prop.Name }</td>
												<td class="px-4 py-2 font-mono text-xs text-muted-foreground">{ prop.Type }</td>
												<td class="px-4 py-2 font-mono text-xs text-muted-foreground">{ prop.Default }</td>
												<td class="px-4 py-2">{ prop.Desc }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						} else {
							<div class="flex flex-wrap gap-2">
								for _, prop := range doc.API {
									@ui.Badge(ui.BadgeProps{Label: prop, Variant: ui.BadgeVariantOutline})
								}
							</div>
						}
					}
				}
			</section>

			if doc.SourceCode != "" {
				<section class="grid gap-4">
					<details class="group">
						<summary class="cursor-pointer list-none">
							<div class="flex items-center gap-2 rounded-lg border border-border/70 bg-card p-4 transition-colors hover:bg-accent/40">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-muted-foreground transition-transform group-open:rotate-90"><polyline points="9 18 15 12 9 6"></polyline></svg>
								<span class="font-medium">View source</span>
							</div>
						</summary>
						<div class="mt-2 rounded-lg border border-border/70 bg-muted p-4">
							<pre class="overflow-x-auto"><code>{ doc.SourceCode }</code></pre>
						</div>
					</details>
				</section>
			}

			<section class="flex items-center justify-between gap-3 border-t border-border/70 pt-6 text-sm">
				<div>
					if hasPrev {
						<a href={ t.SafeURL("/docs/components/" + prev.Slug) } class="text-muted-foreground hover:text-foreground">Previous: { prev.Title }</a>
					}
				</div>
				<div class="text-right">
					if hasNext {
						<a href={ t.SafeURL("/docs/components/" + next.Slug) } class="text-muted-foreground hover:text-foreground">Next: { next.Title }</a>
					}
				</div>
			</section>
		</div>
	}
}

templ BlocksIndexPage() {
	@DocsLayout("Blocks - shadcn/ui", "blocks") {
		<div class="mx-auto flex max-w-6xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Blocks</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Building blocks for dashboards, auth, and app shells.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">The blocks page mirrors the upstream layout library, with the same command-driven install flow and category browsing.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-3">
				for _, category := range BlockCategories() {
					@ui.Card(ui.DOMProps{}) {
						@ui.CardHeader(ui.DOMProps{}) {
							@ui.CardTitle(ui.DOMProps{}) { <span>{ TitleFromSlug(category) }</span> }
							@ui.CardDescription(ui.DOMProps{}) { <span>{ TitleFromSlug(category) } blocks</span> }
						}
						@ui.CardContent(ui.DOMProps{}) {
							<div class="grid gap-2">
								<p class="text-sm text-muted-foreground">{ BlockCategoryCountLabel(category) }</p>
								@ui.Button(ui.ButtonProps{Label: "Browse", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Href: "/blocks/" + category})
							</div>
						}
					}
				}
			</section>

			<section class="grid gap-3">
				for _, block := range Blocks() {
					<a href={ t.SafeURL("/blocks/" + block.Slug) } class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
						<div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
							<div class="space-y-1">
								<div class="flex items-center gap-2">
									<h2 class="text-lg font-medium">{ block.Slug }</h2>
									@ui.Badge(ui.BadgeProps{Label: TitleFromSlug(block.Category), Variant: ui.BadgeVariantOutline})
								</div>
								<p class="text-sm text-muted-foreground">{ block.Description }</p>
							</div>
							<span class="text-sm text-muted-foreground transition-colors group-hover:text-foreground">{ block.Command }</span>
						</div>
					</a>
				}
			</section>
		</div>
	}
}

templ BlockCategoryPage(category string) {
	@DocsLayout("Blocks - "+TitleFromSlug(category), "blocks") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Blocks</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{ TitleFromSlug(category) }</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Category page for { TitleFromSlug(category) } blocks.</p>
			</section>

			<section class="grid gap-4">
				for _, block := range BlocksByCategory(category) {
					@ui.Card(ui.DOMProps{}) {
						@ui.CardHeader(ui.DOMProps{}) {
							@ui.CardTitle(ui.DOMProps{}) { <span>{ block.Slug }</span> }
							@ui.CardDescription(ui.DOMProps{}) { <span>{ block.Description }</span> }
						}
						@ui.CardContent(ui.DOMProps{}) {
							<div class="flex flex-wrap gap-2">
								@ui.Badge(ui.BadgeProps{Label: block.Command, Variant: ui.BadgeVariantOutline})
								@ui.Button(ui.ButtonProps{Label: "Open block", Size: ui.ButtonSizeSM, Href: "/blocks/" + block.Slug})
							</div>
						}
					}
				}
			</section>
		</div>
	}
}

templ BlockDetailPage(block BlockEntry) {
	@DocsLayout("Block - "+block.Title, "blocks") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: TitleFromSlug(block.Category), Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: block.Slug, Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{ block.Title }</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">{ block.Description }</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Preview</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Live preview of the block layout.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<iframe src={ "./preview.html" } class="w-full h-[600px] border rounded-lg" loading="lazy"></iframe>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Install</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Command copied from the upstream block registry.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ block.Command }</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Files</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Expected file footprint for the block.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-2">
							for _, file := range block.Files {
								<div class="rounded-md border border-border/70 px-3 py-2 text-sm">{ file }</div>
							}
						</div>
					}
				}
			</section>
		</div>
	}
}

templ ChartsNav(active string) {
	<nav class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-border/70">
		<a href="/charts/area" class={ ChartNavLinkClass(active, "area") }>Area</a>
		<a href="/charts/bar" class={ ChartNavLinkClass(active, "bar") }>Bar</a>
		<a href="/charts/line" class={ ChartNavLinkClass(active, "line") }>Line</a>
		<a href="/charts/pie" class={ ChartNavLinkClass(active, "pie") }>Pie</a>
		<a href="/charts/radial" class={ ChartNavLinkClass(active, "radial") }>Radial</a>
	</nav>
}

templ ChartsPage() {
	@DocsLayout("Charts - shadcn/ui", "charts") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Charts</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Beautiful charts and graphs.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">A dedicated charts surface that mirrors the official shadcn route and points into the chart component docs.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Chart Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>ChartContainer, ChartTooltip, ChartLegend, and helpers.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open chart docs", Href: "/docs/components/chart"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Examples</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Area, bar, line, pie, and radial chart examples.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open component docs", Variant: ui.ButtonVariantOutline, Href: "/docs/components"})
					}
				}
			</section>
		</div>
	}
}

templ AreaChartPage() {
	@DocsLayout("Area Chart - shadcn/ui", "charts-area") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
