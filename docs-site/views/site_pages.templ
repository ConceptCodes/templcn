templ MCPPage() {
	@DocsLayout("MCP Server - shadcn/ui", "mcp") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">MCP Server</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Model Context Protocol integration.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Connect AI models to shadcn/ui documentation and component examples via MCP.</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>What is MCP?</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>A protocol for AI model context.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="text-sm text-muted-foreground">The Model Context Protocol (MCP) enables AI models to access external tools and context. The shadcn/ui MCP server provides AI assistants with real-time access to component documentation, examples, and best practices.</p>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Setup</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Configure the MCP server for your AI assistant.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>&#123;
  "mcpServers": &#123;
    "shadcn-ui": &#123;
      "command": "npx",
      "args": ["-y", "@shadcn-ui/mcp-server"]
    &#125;
  &#125;
&#125;</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Capabilities</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>What the MCP server provides.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-2">
							<div class="flex items-center gap-2 text-sm">
								<svg class="size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
								<span>Component documentation lookup</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								<svg class="size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
								<span>Code example retrieval</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								<svg class="size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
								<span>API reference queries</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								<svg class="size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
								<span>Best practice recommendations</span>
							</div>
						</div>
					}
				}
			</section>
		</div>
	}
}

templ RegistryPage() {
	@DocsLayout("Registry - shadcn/ui", "registry") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Registry</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Component registry and distribution.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Understand how shadcn/ui components are distributed and managed through the registry.</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>What is the Registry?</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>The source of truth for components.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="text-sm text-muted-foreground">The registry is the centralized repository where all shadcn/ui components are defined, versioned, and documented. When you add a component, you're copying source code from the registry into your project.</p>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Component Structure</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>What makes up a registry component.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="space-y-3">
							<div>
								<p class="mb-1 text-sm font-medium">Source Code</p>
								<p class="text-sm text-muted-foreground">The actual component implementation in templ format.</p>
							</div>
							<div>
								<p class="mb-1 text-sm font-medium">Documentation</p>
								<p class="text-sm text-muted-foreground">Usage examples, API reference, and best practices.</p>
							</div>
							<div>
								<p class="mb-1 text-sm font-medium">Dependencies</p>
								<p class="text-sm text-muted-foreground">Required peer dependencies and Radix UI primitives.</p>
							</div>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Custom Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Create your own registry entries.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="text-sm text-muted-foreground">You can create custom components and share them through the registry. Follow the same structure: component source, documentation, and dependency information. The Directory section showcases community-created components.</p>
					}
				}
			</section>
		</div>
	}
}

templ FormsPage() {
	@DocsLayout("Forms - shadcn/ui", "forms") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Forms</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Building forms with Go/templ.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Create accessible, validated forms using shadcn/ui components and Go backend validation.</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Form Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Essential components for form building.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-2">
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Input", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Text input fields</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Label", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Field labels and descriptions</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Button", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Submit and action buttons</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Select", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Dropdown selections</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Checkbox", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Boolean toggles</span>
							</div>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Server-Side Validation</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Validate forms with Go.</span> }
					}
				@ui.CardContent(ui.DOMProps{}) {
					<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>type FormData struct &#123;
    Name  string
    Email string
&#125;

func HandleForm(w http.ResponseWriter, r *http.Request) &#123;
    var data FormData
    decoder := json.NewDecoder(r.Body)
    decoder.Decode(&amp;data)
    // validate and process data
&#125;</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Error Handling</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Display validation errors to users.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="text-sm text-muted-foreground">Pass validation errors back to your template and display them using the Alert component or inline error messages. Use the Field component to group inputs with their labels and error states.</p>
					}
				}
			</section>
		</div>
	}
}

templ ChangelogPage() {
	@DocsLayout("Changelog - shadcn/ui", "changelog") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Changelog</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Version history and updates.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Track changes, new features, and bug fixes across versions.</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>v2.0.0</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Major release with new components and improvements.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="space-y-3">
							<div>
								<p class="mb-1 text-sm font-medium">Added</p>
								<ul class="ml-4 list-disc text-sm text-muted-foreground">
									<li>New sidebar component with collapsible states</li>
									<li>Resizable panel groups for layouts</li>
									<li>Improved dark mode support</li>
								</ul>
							</div>
							<div>
								<p class="mb-1 text-sm font-medium">Changed</p>
								<ul class="ml-4 list-disc text-sm text-muted-foreground">
									<li>Updated all components to use logical properties for RTL</li>
									<li>Improved TypeScript types for better IDE support</li>
								</ul>
							</div>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>v1.5.0</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Enhanced accessibility and new components.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="space-y-3">
							<div>
								<p class="mb-1 text-sm font-medium">Added</p>
								<ul class="ml-4 list-disc text-sm text-muted-foreground">
									<li>Command palette component</li>
									<li>Combobox with search and multi-select</li>
									<li>Date picker with range support</li>
								</ul>
							</div>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Go/templ Port</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>This Go/templ implementation.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="text-sm text-muted-foreground">This is a Go/templ port of shadcn/ui, maintaining parity with the React/TypeScript version while leveraging Go's performance and templ's compile-time template safety. Component APIs mirror the original where possible.</p>
					}
				}
			</section>
		</div>
	}
}

templ DirectoryDocsPage() {
	@DocsLayout("Directory - shadcn/ui", "directory") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Directory</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Discover community registries.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Browse the registry directory and community extensions for shadcn/ui.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Community registries</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse add-on registries and compatible sources.</span> }
					}
