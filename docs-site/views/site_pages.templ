					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Usage</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>templ AreaChart() &#123;
  // Chart container with area visualization
  // Configure data series and styling
&#125;</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Configuration Options</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-3">
							<div class="rounded-lg border border-border/70 p-3">
								<p class="font-medium">Fill Color</p>
								<p class="text-sm text-muted-foreground">Customize the fill color and opacity for the area under the curve.</p>
							</div>
							<div class="rounded-lg border border-border/70 p-3">
								<p class="font-medium">Line Style</p>
								<p class="text-sm text-muted-foreground">Configure line width, dash patterns, and curve interpolation.</p>
