				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Explore Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the full component library.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "View all components", Variant: ui.ButtonVariantOutline, Href: "/docs/components"})
					}
				}
			</section>

			<section class="rounded-xl border border-border/70 bg-card p-6 shadow-sm">
				<div class="flex flex-col gap-2">
					<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Featured</p>
					<h2 class="text-2xl font-semibold tracking-tight">Community Highlights</h2>
				</div>
				<div class="mt-4 grid gap-3 md:grid-cols-3">
					<div class="rounded-lg border border-border/70 p-4">
