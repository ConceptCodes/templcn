				@PreviewCard("Horizontal", "Space-efficient bars for long labels.", ChartSourceCode("bar-horizontal")) {
					@barChartHorizontalPreview()
				}
				@PreviewCard("Multiple", "Grouped series with two metrics per category.", ChartSourceCode("bar-multiple")) {
					@barChartMultiplePreview()
				}
			</section>
		</div>
	}
}

templ LineChartPage() {
	@DocsLayout("Line Chart - shadcn/ui", "charts-line") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Chart", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Line", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Line Chart</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Show trends and changes in data over time with connected points.</p>
			</section>

			@ChartsNav("line")

			<section class="grid gap-6">
				@PreviewCard("Linear", "Smooth trend lines with point markers.", ChartSourceCode("line-linear")) {
					@lineChartLinearPreview()
				}
				@PreviewCard("Step", "Stepped transitions for state changes.", ChartSourceCode("line-step")) {
					@lineChartStepPreview()
				}
				@PreviewCard("Multiple", "Two lines with a shared axis.", ChartSourceCode("line-multiple")) {
					@lineChartMultiplePreview()
				}
			</section>
		</div>
	}
}

templ PieChartPage() {
	@DocsLayout("Pie Chart - shadcn/ui", "charts-pie") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Chart", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Pie", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Pie Chart</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Display proportions and percentages with circular slices representing data categories.</p>
			</section>

			@ChartsNav("pie")

			<section class="grid gap-6">
				@PreviewCard("Basic", "A simple three-slice pie.", ChartSourceCode("pie-basic")) {
					@pieChartBasicPreview()
				}
				@PreviewCard("Donut", "A ring-style breakdown for categories.", ChartSourceCode("pie-donut")) {
					@pieChartDonutPreview()
				}
				@PreviewCard("Label", "Center label with the main metric.", ChartSourceCode("pie-label")) {
					@pieChartLabelPreview()
				}
			</section>
		</div>
	}
}

templ RadialChartPage() {
