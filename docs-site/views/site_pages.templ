templ CreatePage() {
	@DocsLayout("Create - shadcn/ui", "create") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Create</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Create your Go + templ app</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">This page is adapted for Go and templ, with the install and setup steps rewritten for a Go codebase.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				<a href="/docs/installation" class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
					<div class="space-y-2">
						<div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
						</div>
						<h3 class="text-lg font-medium group-hover:text-primary transition-colors">Go stdlib</h3>
						<p class="text-sm text-muted-foreground">Foundation for Go web applications</p>
					</div>
				</a>
				<a href="/docs/installation" class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
					<div class="space-y-2">
						<div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M2 12h20"/><path d="m4.93 4.93 14.14 14.14"/><path d="m19.07 4.93-14.14 14.14"/></svg>
						</div>
						<h3 class="text-lg font-medium group-hover:text-primary transition-colors">templ</h3>
						<p class="text-sm text-muted-foreground">Compile-time templates for Go</p>
					</div>
				</a>
				<a href="/docs/installation" class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
					<div class="space-y-2">
						<div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
						</div>
						<h3 class="text-lg font-medium group-hover:text-primary transition-colors">HTTP router</h3>
						<p class="text-sm text-muted-foreground">Route requests in your Go app</p>
					</div>
				</a>
				<a href="/docs/installation" class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
					<div class="space-y-2">
						<div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/></svg>
						</div>
						<h3 class="text-lg font-medium group-hover:text-primary transition-colors">UI components</h3>
						<p class="text-sm text-muted-foreground">Compose pages with reusable templ views</p>
					</div>
				</a>
				<a href="/docs/installation" class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
					<div class="space-y-2">
						<div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						</div>
						<h3 class="text-lg font-medium group-hover:text-primary transition-colors">More</h3>
						<p class="text-sm text-muted-foreground">Continue into installation and component docs</p>
					</div>
				</a>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Quick Start</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Get up and running in minutes.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="space-y-6">
							<div class="space-y-3">
								<div class="flex items-start gap-3">
									<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs text-primary-foreground font-medium">1</span>
									<div class="flex-1 space-y-2">
										<p class="text-sm font-medium">Initialize your project</p>
										<p class="text-sm text-muted-foreground">Run the init command to set up shadcn/ui in your project.</p>
										<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>shadcn init</code></pre>
									</div>
								</div>
							</div>
							<div class="space-y-3">
								<div class="flex items-start gap-3">
									<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs text-primary-foreground font-medium">2</span>
									<div class="flex-1 space-y-2">
										<p class="text-sm font-medium">Add components</p>
										<p class="text-sm text-muted-foreground">Add the components you need to your project.</p>
										<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>shadcn add button</code></pre>
										<p class="text-xs text-muted-foreground">Add multiple components:</p>
										<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>shadcn add button card input</code></pre>
									</div>
								</div>
							</div>
							<div class="space-y-3">
								<div class="flex items-start gap-3">
									<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs text-primary-foreground font-medium">3</span>
									<div class="flex-1 space-y-2">
										<p class="text-sm font-medium">Use components</p>
										<p class="text-sm text-muted-foreground">Import and use components in your app.</p>
										@CodeBlock("go", `import "your-project/ui"

templ Page() {
  @ui.Button(ui.ButtonProps{Label: "Click me"})
}`)
									</div>
								</div>
							</div>
						</div>
					}
				}
			</section>

			<section class="rounded-xl border border-border/70 bg-card p-6 shadow-sm">
				<div class="flex flex-col gap-2">
					<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Next Steps</p>
					<h2 class="text-2xl font-semibold tracking-tight">Where to go from here</h2>
				</div>
				<div class="mt-6 grid gap-4 md:grid-cols-3">
					<a href="/docs" class="group flex flex-col gap-2 rounded-lg border border-border/70 p-4 transition-colors hover:border-primary hover:bg-accent/40">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
							<span class="font-medium group-hover:text-primary transition-colors">Documentation</span>
						</div>
						<p class="text-sm text-muted-foreground">Learn about installation, theming, and usage patterns.</p>
					</a>
					<a href="/docs/components" class="group flex flex-col gap-2 rounded-lg border border-border/70 p-4 transition-colors hover:border-primary hover:bg-accent/40">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
							<span class="font-medium group-hover:text-primary transition-colors">Components</span>
						</div>
						<p class="text-sm text-muted-foreground">Browse the component library and view examples.</p>
					</a>
					<a href="/docs/theming" class="group flex flex-col gap-2 rounded-lg border border-border/70 p-4 transition-colors hover:border-primary hover:bg-accent/40">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:text-primary"><path d="M12 2v20"/><path d="M2 12h20"/><path d="m4.93 4.93 14.14 14.14"/><path d="m19.07 4.93-14.14 14.14"/></svg>
							<span class="font-medium group-hover:text-primary transition-colors">Theming</span>
						</div>
						<p class="text-sm text-muted-foreground">Customize colors, typography, and design tokens.</p>
					</a>
				</div>
			</section>
		</div>
	}
}

templ InstallationPage() {
	@DocsLayout("Installation - shadcn/ui", "installation") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Installation</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Install components in your Go/templ project.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Add shadcn/ui components to your Go templ application with the CLI.</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Prerequisites</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Ensure you have Go and templ installed.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="space-y-4">
							<div>
								<p class="mb-2 text-sm font-medium">Install Go</p>
								<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>go version</code></pre>
							</div>
							<div>
								<p class="mb-2 text-sm font-medium">Install templ</p>
								<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>go install github.com/a-h/templ/cmd/templ@latest</code></pre>
							</div>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Install Dependencies</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Use the CLI to add components and their required support files.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="space-y-4">
							<div>
								<p class="mb-2 text-sm font-medium">Add components</p>
								<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>shadcn add button</code></pre>
							</div>
							<div>
								<p class="mb-2 text-sm font-medium">Add multiple components</p>
								<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>shadcn add button card input</code></pre>
							</div>
							<div>
								<p class="mb-2 text-sm font-medium">Add every component</p>
								<pre class="overflow-x-hidden whitespace-pre-wrap break-words rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>shadcn add --all</code></pre>
							</div>
							<p class="text-sm text-muted-foreground">The CLI resolves dependencies, runtime files, styles, and examples for each selected component.</p>
						</div>
					}
				}
			</section>
		</div>
	}
}

templ ThemingPage() {
	@DocsLayout("Theming - shadcn/ui", "theming") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Theming</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Using CSS variables and theme tokens.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Components read semantic tokens like <code class="rounded bg-muted px-1 py-0.5 text-sm">background</code>, <code class="rounded bg-muted px-1 py-0.5 text-sm">primary</code>, and <code class="rounded bg-muted px-1 py-0.5 text-sm">sidebar</code>. Pick a preset, preview it on this site, then copy or download the CSS for your <code class="rounded bg-muted px-1 py-0.5 text-sm">globals.css</code>.</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Theme Presets</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Preview the same token contract your project uses.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-3 sm:grid-cols-2">
							for _, preset := range ThemePresetDocs() {
								<button type="button" data-theme-preset={ preset.Slug } class="group rounded-lg border border-border bg-background p-4 text-left transition-colors hover:bg-accent">
									<div class="mb-4 flex items-center justify-between gap-3">
										<div>
											<p class="font-medium">{ preset.Name }</p>
											<p class="text-sm text-muted-foreground">{ preset.Description }</p>
										</div>
										<div class="flex shrink-0 -space-x-1">
											for _, swatch := range preset.Swatches {
												<span class="size-5 rounded-full border border-background shadow-sm" style={ "background: " + swatch }></span>
											}
										</div>
									</div>
									<div class="grid gap-2 rounded-md border border-border bg-card p-3">
										<div class="h-2 w-20 rounded-full bg-primary"></div>
										<div class="h-2 w-full rounded-full bg-muted"></div>
										<div class="flex gap-2">
											<div class="h-8 flex-1 rounded-md bg-secondary"></div>
											<div class="h-8 flex-1 rounded-md bg-accent"></div>
										</div>
									</div>
								</button>
							}
						</div>
						<div class="mt-4 flex flex-wrap gap-2">
							<button type="button" data-theme-mode="light" class="rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-accent">Light</button>
							<button type="button" data-theme-mode="dark" class="rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-accent">Dark</button>
							<button type="button" data-theme-mode="system" class="rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-accent">System</button>
							<button type="button" data-theme-copy="true" class="rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-accent">Copy current CSS</button>
							<button type="button" data-theme-download="true" class="rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Download globals.css</button>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Token Convention</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Semantic background and foreground pairs map directly into Tailwind utilities.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="overflow-hidden rounded-lg border border-border">
							<table class="w-full text-sm">
								<thead class="bg-muted text-left">
									<tr><th class="px-4 py-3 font-medium">Token</th><th class="px-4 py-3 font-medium">Used by</th></tr>
								</thead>
								<tbody class="divide-y divide-border">
									<tr><td class="px-4 py-3"><code>background / foreground</code></td><td class="px-4 py-3 text-muted-foreground">Page shell and default text.</td></tr>
									<tr><td class="px-4 py-3"><code>card / popover</code></td><td class="px-4 py-3 text-muted-foreground">Cards, menus, dialogs, and floating surfaces.</td></tr>
									<tr><td class="px-4 py-3"><code>primary / secondary / accent</code></td><td class="px-4 py-3 text-muted-foreground">Buttons, selected states, hovers, and badges.</td></tr>
									<tr><td class="px-4 py-3"><code>destructive / border / input / ring</code></td><td class="px-4 py-3 text-muted-foreground">Errors, separators, form controls, and focus rings.</td></tr>
									<tr><td class="px-4 py-3"><code>chart-* / sidebar-*</code></td><td class="px-4 py-3 text-muted-foreground">Charts and app-shell sidebar components.</td></tr>
								</tbody>
							</table>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Default Theme CSS</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Copy this into your global CSS file or use the Download button above.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@CodeBlock("css", DefaultThemeCSS())
					}
				}
			</section>
		</div>
	}
}

templ ComponentsJSONPage() {
	@DocsLayout("components.json - shadcn/ui", "components-json") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Configuration</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Configure component installation.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">The CLI reads <code class="rounded bg-muted px-1 py-0.5 text-sm">components.json</code> to decide where UI source, styles, and runtime assets are copied.</p>
			</section>
			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Example</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Generated by <code>shadcn init</code> and safe to edit.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@CodeBlock("json", `{
  "style": "default",
  "tsx": false,
  "tailwind": {
    "css": "styles/globals.css"
  },
  "aliases": {
    "ui": "ui",
    "runtime": "assets"
  }
}`)
					}
				}
			</section>
		</div>
	}
}

templ PackageImportsPage() {
	@DocsLayout("Package Imports - shadcn/ui", "package-imports") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Imports</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Use local Go packages.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Components are source-copied into your project, so imports point at your app's local <code class="rounded bg-muted px-1 py-0.5 text-sm">ui</code> package.</p>
			</section>
			@CodeBlock("go", `package views

import "your-project/ui"

templ Page() {
  @ui.Button(ui.ButtonProps{Label: "Save"})
}`)
		</div>
	}
}

templ DarkModePage() {
	@DocsLayout("Dark Mode - shadcn/ui", "dark-mode") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Dark Mode</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Toggle dark mode with a class.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">The generated CSS uses the same class strategy as shadcn/ui. Add <code class="rounded bg-muted px-1 py-0.5 text-sm">dark</code> to the root element to activate dark tokens.</p>
			</section>
			<section class="grid gap-4">
				@CodeBlock("html", `<html class="dark">
  <body>...</body>
</html>`)
				@CodeBlock("js", `document.documentElement.classList.toggle("dark")`)
			</section>
		</div>
	}
}

templ MonorepoPage() {
	@DocsLayout("Monorepo - shadcn/ui", "monorepo") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Monorepo</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Install components into the app that owns them.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">For workspaces, run the CLI from the application package or pass <code class="rounded bg-muted px-1 py-0.5 text-sm">--cwd</code> so copied source, runtime, and styles land in the right module.</p>
			</section>
			@CodeBlock("bash", `shadcn init --cwd apps/web
shadcn add button dialog --cwd apps/web`)
		</div>
	}
}

templ JavaScriptPage() {
	@DocsLayout("JavaScript - shadcn/ui", "javascript") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">JavaScript</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Runtime behavior is copied with components.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Interactive primitives use a small vanilla runtime for focus, keyboard navigation, dismissal, form values, and positioning. The CLI installs it only when selected components need it.</p>
			</section>
			@CodeBlock("html", `<script type="module" src="/assets/runtime.js"></script>`)
		</div>
	}
}

templ LLMSPage() {
	@DocsLayout("llms.txt - shadcn/ui", "llms") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">llms.txt</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Point AI tools at local source.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Use the docs, README, and copied component source as context when asking AI tools to modify your Go/templ UI.</p>
			</section>
			@CodeBlock("txt", `# shadcn for Go/templ

- Components live in ./ui
- Runtime behavior lives in ./assets/runtime.js
- Theme tokens live in ./styles/globals.css
- Add components with shadcn add <component>`)
		</div>
	}
}

templ CLIPage() {
	@DocsLayout("CLI - shadcn/ui", "cli") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8 pb-12">
			<section class="space-y-4">
				<div class="flex items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "CLI", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Terminal", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Go tooling for component management</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">This is a Go + templ port of shadcn/ui. Instead of an npm CLI, you use standard Go and templ toolchain commands to install and manage components.</p>
			</section>

			<section class="grid gap-6">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Get the module</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Import the shadcn/ui component package into your Go module.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-4">
							<p class="text-sm text-muted-foreground">Copy the UI package into your project with the CLI:</p>
							@CodeBlock("bash", "shadcn add button")
							<p class="text-sm text-muted-foreground">Or if you're developing this repository in a Go workspace, add the local module path:</p>
							@CodeBlock("bash", "go work use ./ui")
						</div>
					}
				}

				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Generate templ files</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Run the templ code generator after any .templ file change.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-4">
							<p class="text-sm text-muted-foreground">Generate all _templ.go files from .templ sources:</p>
							@CodeBlock("bash", "templ generate")
							<p class="text-sm text-muted-foreground">Or watch for changes during development:</p>
							@CodeBlock("bash", "templ generate --watch")
						</div>
					}
				}

				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Build & run</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Standard Go build commands work as expected.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-6">
							<div class="space-y-2">
								<p class="text-sm font-medium">Run for development</p>
								@CodeBlock("bash", "go run main.go")
							</div>
							<div class="space-y-2">
								<p class="text-sm font-medium">Build a production binary</p>
								@CodeBlock("bash", "go build -o ./bin/app .")
							</div>
							<div class="space-y-2">
								<p class="text-sm font-medium">Generate the static docs site</p>
								@CodeBlock("bash", "go run ./cmd/generate --output ./bin/site")
							</div>
							<div class="space-y-2">
								<p class="text-sm font-medium">Run all tests</p>
								@CodeBlock("bash", "go test ./...")
							</div>
						</div>
					}
				}

				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Using components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Import the ui package and call components directly.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-4">
							<p class="text-sm text-muted-foreground">Each UI component is a regular Go function that returns a templ.Component. Use them with the @ call syntax:</p>
							@CodeBlock("go", cliUsageExample())
						</div>
					}
				}

			</section>
		</div>
	}
}

templ RTLPage() {
	@DocsLayout("RTL - shadcn/ui", "rtl") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8 pb-12">
			<section class="space-y-4">
				<div class="flex items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Layout", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Internationalization", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Right-to-left language support</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Build interfaces that work seamlessly for Arabic, Hebrew, Persian, and other RTL languages using logical properties and directional providers.</p>
			</section>

			<section class="grid gap-6">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Direction Provider</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Wrap your app or sections to set the text direction.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="mb-4 text-sm text-muted-foreground">Use a simple wrapper to set the direction attribute. Components will automatically adapt based on this value.</p>
						@CodeBlock("go", `templ DirectionProvider() {
  <div dir="rtl">
    { children... }
  </div>
}`)
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Logical Properties</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Components use native CSS logical properties.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="mb-4 text-sm text-muted-foreground">Components are built with logical properties like <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.9em]">margin-inline-start</code> ensuring automatic flips in RTL mode.</p>
						@CodeBlock("css", `/* Automatically flips in RTL */
.button {
  margin-inline-start: 0.5rem;
  padding-inline: 1rem;
}`)
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Testing & Verification</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Ensure your layouts render correctly in both directions.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<p class="text-sm text-muted-foreground">Test your components by adding <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.9em]">dir="rtl"</code> to your root HTML element. Our component suite is validated to work out of the box with standard RTL configurations.</p>
					}
				}
			</section>
		</div>
	}
}

templ FormsPage() {
	@DocsLayout("Forms - shadcn/ui", "forms") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8 pb-12">
			<section class="space-y-4">
				<div class="flex items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Components", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Validation", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Building forms with Go and templ</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Create accessible, type-safe, and validated forms using shadcn/ui components combined with Go&#39;s robust backend validation logic.</p>
			</section>

			<section class="grid gap-6">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Form Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>The essential building blocks for data entry.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Input", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Text fields</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Label", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Field titles</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Select", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Dropdowns</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Checkbox", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Toggles</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "Button", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Submissions</span>
							</div>
							<div class="flex items-center gap-2 text-sm">
								@ui.Badge(ui.BadgeProps{Label: "TextArea", Variant: ui.BadgeVariantOutline})
								<span class="text-muted-foreground">Multi-line</span>
							</div>
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Server-Side Handling</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Process and validate submissions in Go.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-4">
							<p class="text-sm text-muted-foreground">Leverage Go's struct tags and standard library for robust form processing:</p>
							@CodeBlock("go", `type SignupData struct {
    Email    string ` + "`" + `json:"email" validate:"required,email"` + "`" + `
    Password string ` + "`" + `json:"password" validate:"required,min=8"` + "`" + `
}

func HandleForm(w http.ResponseWriter, r *http.Request) {
    var data SignupData
    if err := json.NewDecoder(r.Body).Decode(&data); err != nil {
        http.Error(w, "Invalid request", http.StatusBadRequest)
        return
    }
    // Process validated data...
}`)
						</div>
					}
				}
			</section>
		</div>
	}
}

templ ChangelogPage() {
	@DocsLayout("Changelog - shadcn/ui", "changelog") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8 pb-12">
			<section class="space-y-4">
				<div class="flex items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Updates", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Latest: v0.1.0", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Changelog</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Follow the evolution of the shadcn/ui Go port. We document every feature, bug fix, and architectural improvement here.</p>
			</section>

			<section class="space-y-0">
				<div class="relative pl-10">
					<!-- Vertical Line -->
					<div class="absolute left-[15px] top-2 h-full w-px bg-border/70"></div>
					
					<!-- Entry -->
					<div class="relative pb-12">
						<!-- Timeline Node -->
						<div class="absolute -left-[34px] top-1.5 z-10 size-5 rounded-full border-4 border-background bg-primary shadow-[0_0_0_4px_rgba(var(--background),1)] group-hover:scale-110 transition-transform"></div>
						
						<div class="space-y-4">
							<div class="space-y-1">
								<p class="text-sm font-medium leading-none text-muted-foreground">April 2026</p>
								<h3 class="text-2xl font-semibold tracking-tight">Initial Beta Launch (v0.1.0)</h3>
							</div>
							<div class="prose prose-sm prose-invert max-w-none text-muted-foreground">
								<p class="text-base">We&#39;re excited to announce the initial beta of the shadcn/ui Go port! This release brings high-fidelity React-parity components to the Go ecosystem using templ and Tailwind CSS.</p>
								<ul class="mt-6 grid gap-4">
									<li class="flex items-start gap-3">
										<div class="mt-1.5 size-1.5 shrink-0 rounded-full bg-primary/70"></div>
										<span><strong>Interactive Charts:</strong> Recharts-style vanilla SVG rendering with theme-aware tooltips and hovers for all chart types.</span>
									</li>
									<li class="flex items-start gap-3">
										<div class="mt-1.5 size-1.5 shrink-0 rounded-full bg-primary/70"></div>
										<span><strong>Premium Blocks:</strong> High-quality dashboard, authentication, and form building blocks ready for production.</span>
									</li>
									<li class="flex items-start gap-3">
										<div class="mt-1.5 size-1.5 shrink-0 rounded-full bg-primary/70"></div>
										<span><strong>Modern Doc Site:</strong> Fast, searchable documentation with live code previews, syntax highlighting, and responsive navigation.</span>
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	}
}

templ DirectoryDocsPage() {
	@DocsLayout("Directory - shadcn/ui", "directory") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8 pb-12">
			<section class="space-y-4">
				<div class="flex items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Ecosystem", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: "Community", Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Directory</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Explore the ecosystem of components, blocks, and tools built for the shadcn/ui Go port.</p>
