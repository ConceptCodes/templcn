package views

// CodeBlock renders a standalone syntax-highlighted code block.
// lang is a highlight.js language identifier e.g. "go", "bash", "json".
templ CodeBlock(lang string, code string) {
	<div class="relative group" data-code-block="true">
		<pre class="hljs overflow-x-hidden whitespace-pre-wrap break-words rounded-xl p-5 text-[0.8125rem] leading-relaxed"><code class={ "language-" + lang + " whitespace-pre-wrap break-words" }>{ code }</code></pre>
		<button
			type="button"
			data-cb-copy="true"
			aria-label="Copy code"
			class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-white/10 px-2.5 py-1 text-xs font-medium text-white/70 opacity-0 backdrop-blur transition-all hover:bg-white/20 hover:text-white group-hover:opacity-100 focus-visible:opacity-100"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
			<span>Copy</span>
		</button>
		<script>
			(function() {
				var block = document.currentScript && document.currentScript.closest('[data-code-block="true"]');
				if (!block) return;
				var codeEl = block.querySelector('code');
				var copyBtn = block.querySelector('[data-cb-copy="true"]');

				// Highlight as soon as hljs is available (it's loaded sync so it should be).
				function tryHighlight() {
					if (window.hljs && codeEl && !codeEl.dataset.highlighted) {
						window.hljs.highlightElement(codeEl);
					}
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', tryHighlight);
				} else {
					tryHighlight();
				}

				// Copy button
				copyBtn && copyBtn.addEventListener('click', async function() {
					var label = copyBtn.querySelector('span') || copyBtn;
					try {
						await navigator.clipboard.writeText(codeEl ? codeEl.textContent : '');
						label.textContent = 'Copied!';
						var svg = copyBtn.querySelector('svg');
						if (svg) svg.style.opacity = '0';
						setTimeout(function() {
							label.textContent = 'Copy';
							if (svg) svg.style.opacity = '';
						}, 1500);
					} catch (_) {
						label.textContent = 'Failed';
						setTimeout(function() { label.textContent = 'Copy'; }, 1500);
					}
				});
			})();
		</script>
	</div>
}
