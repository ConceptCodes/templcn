package views

import (
	t "github.com/a-h/templ"
	"shadcn/ui"
)

templ DocsLayout(title string, active string) {
	@Page(title) {
		<div class="min-h-svh bg-background">
			<div class="mx-auto flex min-h-svh max-w-7xl flex-col lg:flex-row">
				<aside class="border-b border-border/70 px-6 py-6 lg:w-72 lg:border-r lg:border-b-0">
					<div class="space-y-6">
						<div class="space-y-2">
							<a href="/" class="inline-flex items-center gap-2 font-semibold tracking-tight">
								<span class="flex size-7 items-center justify-center rounded-md bg-primary text-xs text-primary-foreground">S</span>
								<span>shadcn/ui</span>
							</a>
							<p class="text-sm text-muted-foreground">Copy, paste, and adapt the source.</p>
						</div>

						<nav class="grid gap-1 text-sm">
							<a href="/docs" class={ SectionLinkClass(active, "docs") }>Introduction</a>
							<a href="/docs/components" class={ SectionLinkClass(active, "components") }>Components</a>
							<a href="/blocks" class={ SectionLinkClass(active, "blocks") }>Blocks</a>
							<a href="/charts" class={ SectionLinkClass(active, "charts") }>Charts</a>
							<a href="/directory" class={ SectionLinkClass(active, "directory") }>Directory</a>
						</nav>

						<div class="space-y-2">
							<p class="text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground">Components</p>
							<div class="max-h-[32rem] overflow-auto pr-1">
								<div class="grid gap-1 text-sm">
									for _, doc := range ComponentIndex() {
										<a
											href={ t.SafeURL("/docs/components/" + doc.Slug) }
											class={ ComponentLinkClass(active, doc.Slug) }
										>
											{ doc.Title }
										</a>
									}
								</div>
								</div>
							</div>
						</div>
				</aside>

				<main class="flex-1 px-6 py-10 lg:px-10">
					{ children... }
				</main>
			</div>
		</div>
	}
}

templ DocsIndexPage() {
	@DocsLayout("Introduction - shadcn/ui", "docs") {
		<div class="mx-auto flex max-w-4xl flex-col gap-10">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Introduction</p>
				<h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">A code distribution platform for Go and templ.</h1>
				<p class="max-w-2xl text-lg leading-8 text-muted-foreground">This mirror keeps the shadcn information architecture intact: landing page, blocks, docs, component pages, and the registry directory all land on the same routes a shadcn user expects.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the individual docs pages for each component.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="flex items-center gap-3">
							@ui.Button(ui.ButtonProps{Label: "Open components", Href: "/docs/components"})
						</div>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Blocks</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the prebuilt dashboard and auth layouts.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open blocks", Variant: ui.ButtonVariantOutline, Href: "/blocks"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Charts</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Chart docs and examples built around the same tokens.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open charts", Variant: ui.ButtonVariantOutline, Href: "/charts"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Directory</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse the registry directory and community extensions.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open directory", Variant: ui.ButtonVariantOutline, Href: "/directory"})
					}
				}
			</section>

			<section class="grid gap-4 rounded-xl border border-border/70 bg-card p-6 shadow-sm">
				<div class="flex flex-col gap-2">
					<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Principles</p>
					<h2 class="text-2xl font-semibold tracking-tight">Open code, composition, distribution.</h2>
				</div>
				<div class="grid gap-3 md:grid-cols-3">
					<div class="rounded-lg border border-border/70 p-4">
						<p class="font-medium">Open code</p>
						<p class="mt-2 text-sm text-muted-foreground">Each component is a source file in the repo, not a sealed package.</p>
					</div>
					<div class="rounded-lg border border-border/70 p-4">
						<p class="font-medium">Composition</p>
						<p class="mt-2 text-sm text-muted-foreground">Every page is built from the same primitives the app consumes.</p>
					</div>
					<div class="rounded-lg border border-border/70 p-4">
						<p class="font-medium">Distribution</p>
						<p class="mt-2 text-sm text-muted-foreground">Routes, docs, and blocks are organized like the official shadcn site.</p>
					</div>
				</div>
			</section>
		</div>
	}
}

templ ComponentsIndexPage() {
	@DocsLayout("Components - shadcn/ui", "components") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Components</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Browse the component docs one page at a time.</h1>
				<p class="max-w-2xl text-lg leading-8 text-muted-foreground">This page mirrors the shadcn component index and links each component to its own detail page.</p>
			</section>

			<section class="grid gap-3">
				for _, doc := range ComponentIndex() {
					<a href={ t.SafeURL("/docs/components/" + doc.Slug) } class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
						<div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
							<div class="space-y-1">
								<div class="flex items-center gap-2">
									<h2 class="text-lg font-medium">{ doc.Title }</h2>
									@ui.Badge(ui.BadgeProps{Label: doc.Slug, Variant: ui.BadgeVariantOutline})
								</div>
								<p class="text-sm text-muted-foreground">{ doc.Description }</p>
							</div>
							<span class="text-sm text-muted-foreground transition-colors group-hover:text-foreground">{ doc.Install }</span>
						</div>
					</a>
				}
			</section>
		</div>
	}
}

templ ComponentDetailPage(doc ComponentDocEntry, prev ComponentDocEntry, hasPrev bool, next ComponentDocEntry, hasNext bool) {
	@DocsLayout("Component - "+doc.Title, "component-"+doc.Slug) {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: "Component", Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: doc.Slug, Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{ doc.Title }</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">{ doc.Description }</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Installation</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Use the same CLI command shadcn users expect.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ doc.Install }</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Usage</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Go-facing shape for this port.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ doc.Usage }</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>API</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Props and example exports to implement.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
							<div class="flex flex-wrap gap-2">
							for _, prop := range doc.API {
								@ui.Badge(ui.BadgeProps{Label: prop, Variant: ui.BadgeVariantOutline})
							}
							</div>
						}
					}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Exports</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Compound pieces that should exist in the Go package.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
							<div class="flex flex-wrap gap-2">
							for _, example := range doc.Example {
								@ui.Badge(ui.BadgeProps{Label: example, Variant: ui.BadgeVariantSecondary})
							}
							</div>
						}
					}
			</section>

			<section class="flex items-center justify-between gap-3 border-t border-border/70 pt-6 text-sm">
				<div>
					if hasPrev {
						<a href={ t.SafeURL("/docs/components/" + prev.Slug) } class="text-muted-foreground hover:text-foreground">Previous: { prev.Title }</a>
					}
				</div>
				<div class="text-right">
					if hasNext {
						<a href={ t.SafeURL("/docs/components/" + next.Slug) } class="text-muted-foreground hover:text-foreground">Next: { next.Title }</a>
					}
				</div>
			</section>
		</div>
	}
}

templ BlocksIndexPage() {
	@DocsLayout("Blocks - shadcn/ui", "blocks") {
		<div class="mx-auto flex max-w-6xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Blocks</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Building blocks for dashboards, auth, and app shells.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">The blocks page mirrors the upstream layout library, with the same command-driven install flow and category browsing.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-3">
				for _, category := range BlockCategories() {
					@ui.Card(ui.DOMProps{}) {
						@ui.CardHeader(ui.DOMProps{}) {
							@ui.CardTitle(ui.DOMProps{}) { <span>{ TitleFromSlug(category) }</span> }
							@ui.CardDescription(ui.DOMProps{}) { <span>{ TitleFromSlug(category) } blocks</span> }
						}
						@ui.CardContent(ui.DOMProps{}) {
							<div class="grid gap-2">
								<p class="text-sm text-muted-foreground">{ BlockCategoryCountLabel(category) }</p>
								@ui.Button(ui.ButtonProps{Label: "Browse", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Href: "/blocks/" + category})
							</div>
						}
					}
				}
			</section>

			<section class="grid gap-3">
				for _, block := range Blocks() {
					<a href={ t.SafeURL("/blocks/" + block.Slug) } class="group rounded-xl border border-border/70 bg-card p-4 shadow-sm transition-colors hover:border-border hover:bg-accent/40">
						<div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
							<div class="space-y-1">
								<div class="flex items-center gap-2">
									<h2 class="text-lg font-medium">{ block.Slug }</h2>
									@ui.Badge(ui.BadgeProps{Label: TitleFromSlug(block.Category), Variant: ui.BadgeVariantOutline})
								</div>
								<p class="text-sm text-muted-foreground">{ block.Description }</p>
							</div>
							<span class="text-sm text-muted-foreground transition-colors group-hover:text-foreground">{ block.Command }</span>
						</div>
					</a>
				}
			</section>
		</div>
	}
}

templ BlockCategoryPage(category string) {
	@DocsLayout("Blocks - "+TitleFromSlug(category), "blocks") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Blocks</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{ TitleFromSlug(category) }</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">Category page for { TitleFromSlug(category) } blocks.</p>
			</section>

			<section class="grid gap-4">
				for _, block := range BlocksByCategory(category) {
					@ui.Card(ui.DOMProps{}) {
						@ui.CardHeader(ui.DOMProps{}) {
							@ui.CardTitle(ui.DOMProps{}) { <span>{ block.Slug }</span> }
							@ui.CardDescription(ui.DOMProps{}) { <span>{ block.Description }</span> }
						}
						@ui.CardContent(ui.DOMProps{}) {
							<div class="flex flex-wrap gap-2">
								@ui.Badge(ui.BadgeProps{Label: block.Command, Variant: ui.BadgeVariantOutline})
								@ui.Button(ui.ButtonProps{Label: "Open block", Size: ui.ButtonSizeSM, Href: "/blocks/" + block.Slug})
							</div>
						}
					}
				}
			</section>
		</div>
	}
}

templ BlockDetailPage(block BlockEntry) {
	@DocsLayout("Block - "+block.Title, "blocks") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					@ui.Badge(ui.BadgeProps{Label: TitleFromSlug(block.Category), Variant: ui.BadgeVariantSecondary})
					@ui.Badge(ui.BadgeProps{Label: block.Slug, Variant: ui.BadgeVariantOutline})
				</div>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{ block.Title }</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">{ block.Description }</p>
			</section>

			<section class="grid gap-4">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Install</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Command copied from the upstream block registry.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<pre class="overflow-x-auto rounded-lg border border-border/70 bg-muted p-4 text-sm"><code>{ block.Command }</code></pre>
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Files</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Expected file footprint for the block.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						<div class="grid gap-2">
							for _, file := range block.Files {
								<div class="rounded-md border border-border/70 px-3 py-2 text-sm">{ file }</div>
							}
						</div>
					}
				}
			</section>
		</div>
	}
}

templ ChartsPage() {
	@DocsLayout("Charts - shadcn/ui", "charts") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Charts</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Beautiful charts and graphs.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">A dedicated charts surface that mirrors the official shadcn route and points into the chart component docs.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Chart Components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>ChartContainer, ChartTooltip, ChartLegend, and helpers.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open chart docs", Href: "/docs/components/chart"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Examples</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Area, bar, line, pie, and radial chart examples.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open component docs", Variant: ui.ButtonVariantOutline, Href: "/docs/components"})
					}
				}
			</section>
		</div>
	}
}

templ DirectoryPage() {
	@DocsLayout("Directory - shadcn/ui", "directory") {
		<div class="mx-auto flex max-w-5xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Registry Directory</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Discover community registries.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">This page stands in for the upstream registry directory route and gives you a place to wire community packages into the same navigation model.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Community registries</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Browse add-on registries and compatible sources.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open blocks", Variant: ui.ButtonVariantOutline, Href: "/blocks"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Project setup</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Use the same design tokens and component contracts throughout.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "Open docs", Href: "/docs"})
					}
				}
			</section>
		</div>
	}
}

templ CreatePage() {
	@DocsLayout("Create - shadcn/ui", "create") {
		<div class="mx-auto flex max-w-4xl flex-col gap-8">
			<section class="space-y-4">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-muted-foreground">Create</p>
				<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Create your own version of the system.</h1>
				<p class="max-w-3xl text-lg leading-8 text-muted-foreground">This route mirrors the upstream start-here flow and keeps the “new project” CTA from the landing page from becoming a dead end.</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2">
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Start with components</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Add the component set that fits your app.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "View components", Href: "/docs/components"})
					}
				}
				@ui.Card(ui.DOMProps{}) {
					@ui.CardHeader(ui.DOMProps{}) {
						@ui.CardTitle(ui.DOMProps{}) { <span>Start with blocks</span> }
						@ui.CardDescription(ui.DOMProps{}) { <span>Use a block as your layout foundation.</span> }
					}
					@ui.CardContent(ui.DOMProps{}) {
						@ui.Button(ui.ButtonProps{Label: "View blocks", Variant: ui.ButtonVariantOutline, Href: "/blocks"})
					}
				}
			</section>
		</div>
	}
}
