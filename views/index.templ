package views

import (
	t "github.com/a-h/templ"
	"shadcn/ui"
)

templ Index() {
	@Page() {
		<main class="relative isolate overflow-hidden">
			<div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(circle_at_top,rgba(0,0,0,0.08),transparent_55%)] dark:bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_55%)]"></div>
			<div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-80 w-80 -translate-x-1/2 rounded-full bg-primary/5 blur-3xl"></div>

			<section class="mx-auto flex max-w-7xl flex-col gap-10 px-6 pb-8 pt-6 lg:pb-12">
				<nav class="flex flex-wrap items-center justify-between gap-4 rounded-full border border-border/80 bg-background/90 px-4 py-3 shadow-sm backdrop-blur supports-[backdrop-filter]:bg-background/75">
					<div class="flex items-center gap-6">
						<a href="/" class="flex items-center gap-2">
							<span class="flex size-8 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">S</span>
							<span class="text-sm font-semibold tracking-tight">shadcn/ui</span>
						</a>
						<div class="hidden items-center gap-1 lg:flex">
							@ui.Button(ui.ButtonProps{
								Label:   "Docs",
								Variant: ui.ButtonVariantGhost,
								Size:    ui.ButtonSizeSM,
								Href:    "/docs",
							})
							@ui.Button(ui.ButtonProps{
								Label:   "Components",
								Variant: ui.ButtonVariantGhost,
								Size:    ui.ButtonSizeSM,
								Href:    "/docs/components",
							})
							@ui.Button(ui.ButtonProps{
								Label:   "Blocks",
								Variant: ui.ButtonVariantGhost,
								Size:    ui.ButtonSizeSM,
								Href:    "/blocks",
							})
							@ui.Button(ui.ButtonProps{
								Label:   "Charts",
								Variant: ui.ButtonVariantGhost,
								Size:    ui.ButtonSizeSM,
								Href:    "/charts",
							})
							@ui.Button(ui.ButtonProps{
								Label:   "Directory",
								Variant: ui.ButtonVariantGhost,
								Size:    ui.ButtonSizeSM,
								Href:    "/directory",
							})
						</div>
					</div>
					<div class="flex items-center gap-2">
						@ui.DropdownMenu(ui.DropdownMenuProps{}) {
							@ui.DropdownMenuTrigger(ui.DOMProps{
								Class: "inline-flex h-9 items-center rounded-full border border-border bg-background px-3 text-sm font-medium shadow-sm transition-colors hover:bg-accent",
								Attrs: t.Attributes{
									"type": "button",
								},
							}) {
								<span>Menu</span>
							}
							@ui.DropdownMenuContent(ui.DOMProps{Class: "mt-2 min-w-48"}) {
								@ui.DropdownMenuLabel(ui.DOMProps{}) {
									<span>Resources</span>
								}
								@ui.DropdownMenuSeparator(ui.DOMProps{})
								@ui.DropdownMenuItem(ui.DropdownMenuItemProps{
									DOMProps: ui.DOMProps{
										Attrs: t.Attributes{"type": "button", "onclick": "location.href='/docs'"},
									},
								}) {
									<span>Docs</span>
								}
								@ui.DropdownMenuItem(ui.DropdownMenuItemProps{
									DOMProps: ui.DOMProps{
										Attrs: t.Attributes{"type": "button", "onclick": "location.href='/docs/components'"},
									},
								}) {
									<span>Components</span>
								}
								@ui.DropdownMenuItem(ui.DropdownMenuItemProps{
									DOMProps: ui.DOMProps{
										Attrs: t.Attributes{"type": "button", "onclick": "location.href='/blocks'"},
									},
								}) {
									<span>Blocks</span>
								}
							}
						}
						@ui.Button(ui.ButtonProps{
							Label:   "Search documentation...",
							Variant: ui.ButtonVariantOutline,
							Size:    ui.ButtonSizeSM,
							DOMProps: ui.DOMProps{
								Attrs: t.Attributes{
									"type":        "button",
									"aria-label":  "Search documentation",
								},
							},
						})
						@ui.Kbd(ui.KbdProps{
							Text: "⌘K",
							Size: "sm",
						})
						@ui.Button(ui.ButtonProps{
							Label:   "GitHub",
							Variant: ui.ButtonVariantGhost,
							Size:    ui.ButtonSizeSM,
							Href:    "https://github.com/shadcn-ui/ui",
						})
						@ui.Button(ui.ButtonProps{
							Label:   "Twitter",
							Variant: ui.ButtonVariantGhost,
							Size:    ui.ButtonSizeSM,
							Href:    "https://twitter.com/shadcn",
						})
						@ui.Button(ui.ButtonProps{
							Label:   "Theme",
							Variant: ui.ButtonVariantOutline,
							Size:    ui.ButtonSizeSM,
							DOMProps: ui.DOMProps{
								Attrs: t.Attributes{
									"type":              "button",
									"data-theme-toggle": "true",
								},
							},
						})
					</div>
				</nav>
			</section>

			<section class="mx-auto grid max-w-7xl gap-12 px-6 py-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-12">
				<div class="space-y-8">
					@ui.Badge(ui.BadgeProps{
						Label:   "New",
						Variant: ui.BadgeVariantOutline,
						DOMProps: ui.DOMProps{
							Class: "rounded-full px-3 py-1 text-[0.7rem] uppercase tracking-[0.28em]",
						},
					})
					<div class="space-y-6">
						<h1 class="max-w-2xl text-5xl font-semibold tracking-tight text-foreground sm:text-6xl lg:text-7xl">The Foundation for your Design System</h1>
						<p class="max-w-2xl text-base leading-8 text-muted-foreground sm:text-lg">A set of beautifully designed components that you can customize, extend, and build on. Start here then make it your own. Open Source. Open Code.</p>
					</div>
					<div class="flex flex-wrap gap-3">
						@ui.Button(ui.ButtonProps{
							Label:   "New Project",
							Variant: ui.ButtonVariantDefault,
							Size:    ui.ButtonSizeDefault,
							Href:    "/create",
						})
						@ui.Button(ui.ButtonProps{
							Label:   "View Components",
							Variant: ui.ButtonVariantOutline,
							Size:    ui.ButtonSizeDefault,
							Href:    "/docs/components",
						})
					</div>
					<div class="flex flex-wrap gap-2 text-sm text-muted-foreground">
						<span>Open Source.</span>
						<span>Open Code.</span>
						<span>Built for Go + templ.</span>
					</div>
				</div>

				<div class="relative">
					<div class="absolute -inset-6 rounded-[2rem] bg-primary/5 blur-3xl"></div>
					@ui.Card(ui.DOMProps{
						Class: "relative overflow-hidden border-border/80 bg-background/90 shadow-xl backdrop-blur",
					}) {
						@ui.CardHeader(ui.DOMProps{}) {
							<div class="flex items-start justify-between gap-4">
								<div class="space-y-1">
									@ui.CardTitle(ui.DOMProps{}) {
										<span>Payment Method</span>
									}
									@ui.CardDescription(ui.DOMProps{}) {
										<span>All transactions are secure and encrypted.</span>
									}
								</div>
								@ui.Badge(ui.BadgeProps{
									Label:   "Preview",
									Variant: ui.BadgeVariantSecondary,
								})
							</div>
						}
						@ui.CardContent(ui.DOMProps{}) {
							<div class="grid gap-4">
								<div class="grid gap-2">
									@ui.Label(ui.LabelProps{For: "hero-name"}) {
										<span>Name on Card</span>
									}
									@ui.Input(ui.InputProps{
										DOMProps: ui.DOMProps{ID: "hero-name"},
										Placeholder: "Jane Doe",
									})
								</div>
								<div class="grid gap-2">
									@ui.Label(ui.LabelProps{For: "hero-card"}) {
										<span>Card Number</span>
									}
									@ui.Input(ui.InputProps{
										DOMProps: ui.DOMProps{ID: "hero-card"},
										Placeholder: "Enter your 16-digit number.",
									})
								</div>
								<div class="grid grid-cols-2 gap-3">
									<div class="grid gap-2">
										@ui.Label(ui.LabelProps{For: "hero-cvv"}) {
											<span>CVV</span>
										}
										@ui.Input(ui.InputProps{
											DOMProps: ui.DOMProps{ID: "hero-cvv"},
											Placeholder: "123",
										})
									</div>
									<div class="grid gap-2">
										@ui.Label(ui.LabelProps{For: "hero-exp"}) {
											<span>Expiry</span>
										}
										@ui.Input(ui.InputProps{
											DOMProps: ui.DOMProps{ID: "hero-exp"},
											Placeholder: "MM / YYYY",
										})
									</div>
								</div>
							</div>
						}
						@ui.CardFooter(ui.DOMProps{Class: "flex items-center justify-between"}) {
							@ui.Badge(ui.BadgeProps{
								Label:   "Secure",
								Variant: ui.BadgeVariantOutline,
							})
							<div class="flex gap-2">
								@ui.Button(ui.ButtonProps{
									Label:   "Cancel",
									Variant: ui.ButtonVariantOutline,
									Size:    ui.ButtonSizeSM,
									Type:    "button",
								})
								@ui.Button(ui.ButtonProps{
									Label:   "Submit",
									Variant: ui.ButtonVariantDefault,
									Size:    ui.ButtonSizeSM,
									Type:    "button",
								})
							</div>
						}
					}
				</div>
			</section>

			<section class="mx-auto max-w-7xl px-6 pb-24">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
					<div class="space-y-3">
						<p class="text-sm font-medium uppercase tracking-[0.3em] text-muted-foreground">Preview surface</p>
						<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Eight layouts, one component system.</h2>
					</div>
					<p class="max-w-2xl text-sm leading-6 text-muted-foreground">The tabbed demo below is built from the Go components in this repo, showing the same surface area you would expect from shadcn/ui, but adapted for templ and server rendering.</p>
				</div>

				@ui.Tabs(ui.TabsProps{
					DefaultValue: "mail",
				}) {
					@ui.TabsList(ui.TabsListProps{
						Variant: "line",
						DOMProps: ui.DOMProps{
							Class: "mt-8 w-full flex-wrap justify-start gap-2 overflow-auto py-1",
						},
					}) {
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "mail", Active: true}) { <span>Mail</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "dashboard"}) { <span>Dashboard</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "cards"}) { <span>Cards</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "tasks"}) { <span>Tasks</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "playground"}) { <span>Playground</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "forms"}) { <span>Forms</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "music"}) { <span>Music</span> }
						@ui.TabsTrigger(ui.TabsTriggerProps{Value: "auth"}) { <span>Authentication</span> }
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "mail", Active: true}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-[240px_minmax(0,1fr)]">
							@ui.Sidebar(ui.SidebarProps{
								Side:        "left",
								Variant:     "floating",
								Collapsible: "none",
								DOMProps: ui.DOMProps{
									Class: "rounded-[1.5rem] border border-border/80 bg-sidebar/35 p-3 shadow-sm",
								},
							}) {
								@ui.SidebarHeader(ui.DOMProps{Class: "p-2"}) {
									<div class="flex items-center justify-between gap-3">
										<div>
											<p class="text-sm font-semibold">Inbox</p>
											<p class="text-xs text-muted-foreground">42 unread</p>
										</div>
										@ui.Badge(ui.BadgeProps{Label: "Live", Variant: ui.BadgeVariantSecondary})
									</div>
								}
								@ui.SidebarContent(ui.DOMProps{Class: "p-2"}) {
									@ui.SidebarGroup(ui.DOMProps{}) {
										@ui.SidebarGroupLabel(ui.DOMProps{}) { <span>Folders</span> }
										@ui.SidebarMenu(ui.DOMProps{}) {
											@ui.SidebarMenuItem(ui.DOMProps{}) { @ui.SidebarMenuButton(ui.SidebarMenuButtonProps{IsActive: true}) { <span>Inbox</span> } }
											@ui.SidebarMenuItem(ui.DOMProps{}) { @ui.SidebarMenuButton(ui.SidebarMenuButtonProps{}) { <span>Sent</span> } }
											@ui.SidebarMenuItem(ui.DOMProps{}) { @ui.SidebarMenuButton(ui.SidebarMenuButtonProps{}) { <span>Drafts</span> } }
										}
									}
									@ui.SidebarGroup(ui.DOMProps{Class: "mt-4"}) {
										@ui.SidebarGroupLabel(ui.DOMProps{}) { <span>Labels</span> }
										@ui.SidebarMenu(ui.DOMProps{}) {
											@ui.SidebarMenuItem(ui.DOMProps{}) { @ui.SidebarMenuButton(ui.SidebarMenuButtonProps{}) { <span>Launches</span> } }
											@ui.SidebarMenuItem(ui.DOMProps{}) { @ui.SidebarMenuButton(ui.SidebarMenuButtonProps{}) { <span>Support</span> } }
											@ui.SidebarMenuItem(ui.DOMProps{}) { @ui.SidebarMenuButton(ui.SidebarMenuButtonProps{}) { <span>Billing</span> } }
										}
									}
								}
							}

							@ui.Card(ui.DOMProps{Class: "border-border/80 bg-background/90 shadow-sm"}) {
								@ui.CardHeader(ui.DOMProps{Class: "flex-row items-center justify-between space-y-0"}) {
									<div>
										@ui.CardTitle(ui.DOMProps{}) { <span>Recent Messages</span> }
										@ui.CardDescription(ui.DOMProps{}) { <span>Short, dense, and focused on the next action.</span> }
									</div>
									@ui.Button(ui.ButtonProps{Label: "Compose", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-3"}) {
									<div class="grid gap-3 rounded-lg border border-border/70 p-4">
										<div class="flex items-start gap-3">
											@ui.Avatar(ui.AvatarProps{Size: "sm"}) {
												@ui.AvatarFallback(ui.DOMProps{}) { <span>AR</span> }
											}
											<div class="min-w-0 flex-1">
												<div class="flex items-center justify-between gap-3">
													<p class="font-medium">Ava Richards</p>
													<p class="text-xs text-muted-foreground">9:42 AM</p>
												</div>
												<p class="text-sm text-muted-foreground">Ship the homepage preview to the design review channel.</p>
											</div>
											@ui.Badge(ui.BadgeProps{Label: "New", Variant: ui.BadgeVariantOutline})
										</div>
									</div>
									<div class="grid gap-3 rounded-lg border border-border/70 p-4">
										<div class="flex items-start gap-3">
											@ui.Avatar(ui.AvatarProps{Size: "sm"}) {
												@ui.AvatarFallback(ui.DOMProps{}) { <span>MK</span> }
											}
											<div class="min-w-0 flex-1">
												<div class="flex items-center justify-between gap-3">
													<p class="font-medium">Mina Kapoor</p>
													<p class="text-xs text-muted-foreground">Yesterday</p>
												</div>
												<p class="text-sm text-muted-foreground">Can we add a clearer CTA and keep the density high?</p>
											</div>
											@ui.Badge(ui.BadgeProps{Label: "Reply", Variant: ui.BadgeVariantSecondary})
										</div>
									</div>
									<div class="grid gap-3 rounded-lg border border-border/70 p-4">
										<div class="flex items-start gap-3">
											@ui.Avatar(ui.AvatarProps{Size: "sm"}) {
												@ui.AvatarFallback(ui.DOMProps{}) { <span>JS</span> }
											}
											<div class="min-w-0 flex-1">
												<div class="flex items-center justify-between gap-3">
													<p class="font-medium">Jonas Shaw</p>
													<p class="text-xs text-muted-foreground">2 days ago</p>
												</div>
												<p class="text-sm text-muted-foreground">The sidebar layout is ready for review. Sending the latest screenshot now.</p>
											</div>
										</div>
									</div>
								}
							}
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "dashboard"}) {
						<div class="mt-8 grid gap-6">
							<div class="grid gap-4 md:grid-cols-3">
								@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
									@ui.CardHeader(ui.DOMProps{Class: "pb-2"}) {
										@ui.CardDescription(ui.DOMProps{}) { <span>Active Users</span> }
										@ui.CardTitle(ui.DOMProps{}) { <span>18.4k</span> }
									}
									@ui.CardContent(ui.DOMProps{Class: "pt-0"}) {
										<p class="text-sm text-muted-foreground">+12% over the last 7 days</p>
									}
								}
								@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
									@ui.CardHeader(ui.DOMProps{Class: "pb-2"}) {
										@ui.CardDescription(ui.DOMProps{}) { <span>Revenue</span> }
										@ui.CardTitle(ui.DOMProps{}) { <span>$42.1k</span> }
									}
									@ui.CardContent(ui.DOMProps{Class: "pt-0"}) {
										<p class="text-sm text-muted-foreground">+8.2% compared to last month</p>
									}
								}
								@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
									@ui.CardHeader(ui.DOMProps{Class: "pb-2"}) {
										@ui.CardDescription(ui.DOMProps{}) { <span>Conversion</span> }
										@ui.CardTitle(ui.DOMProps{}) { <span>4.8%</span> }
									}
									@ui.CardContent(ui.DOMProps{Class: "pt-0"}) {
										<p class="text-sm text-muted-foreground">Stable across web and mobile</p>
									}
								}
							</div>

							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{Class: "flex-row items-center justify-between space-y-0"}) {
									<div>
										@ui.CardTitle(ui.DOMProps{}) { <span>Recent Invoices</span> }
										@ui.CardDescription(ui.DOMProps{}) { <span>Dense tables remain readable with the shared tokens.</span> }
									</div>
									@ui.Badge(ui.BadgeProps{Label: "12 results", Variant: ui.BadgeVariantOutline})
								}
								@ui.CardContent(ui.DOMProps{Class: "pt-0"}) {
									@ui.Table(ui.DOMProps{}) {
										@ui.TableHeader(ui.DOMProps{}) {
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableHead(ui.DOMProps{}) { <span>Customer</span> }
												@ui.TableHead(ui.DOMProps{}) { <span>Status</span> }
												@ui.TableHead(ui.DOMProps{}) { <span>Method</span> }
												@ui.TableHead(ui.DOMProps{}) { <span>Amount</span> }
											}
										}
										@ui.TableBody(ui.DOMProps{}) {
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableCell(ui.DOMProps{}) { <span>Acme Corp</span> }
												@ui.TableCell(ui.DOMProps{}) { @ui.Badge(ui.BadgeProps{Label: "Paid", Variant: ui.BadgeVariantSecondary}) }
												@ui.TableCell(ui.DOMProps{}) { <span>Wire</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>$12,400</span> }
											}
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableCell(ui.DOMProps{}) { <span>Northwind</span> }
												@ui.TableCell(ui.DOMProps{}) { @ui.Badge(ui.BadgeProps{Label: "Pending", Variant: ui.BadgeVariantOutline}) }
												@ui.TableCell(ui.DOMProps{}) { <span>Card</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>$8,900</span> }
											}
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableCell(ui.DOMProps{}) { <span>Globex</span> }
												@ui.TableCell(ui.DOMProps{}) { @ui.Badge(ui.BadgeProps{Label: "Draft", Variant: ui.BadgeVariantGhost}) }
												@ui.TableCell(ui.DOMProps{}) { <span>ACH</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>$2,100</span> }
											}
										}
									}
								}
							}
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "cards"}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-3">
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									<div class="flex items-center justify-between">
										<div>
											@ui.CardTitle(ui.DOMProps{}) { <span>Project Card</span> }
											@ui.CardDescription(ui.DOMProps{}) { <span>Composable cards keep the surface consistent.</span> }
										</div>
										@ui.Avatar(ui.AvatarProps{Size: "sm"}) {
											@ui.AvatarFallback(ui.DOMProps{}) { <span>JD</span> }
										}
									</div>
								}
								@ui.CardContent(ui.DOMProps{}) {
									<div class="grid gap-3">
										@ui.Badge(ui.BadgeProps{Label: "Dashboard", Variant: ui.BadgeVariantOutline})
										<p class="text-sm text-muted-foreground">Bring the same spacing and hierarchy into every card variant.</p>
									</div>
								}
							}
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Billing Card</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Tokens align across forms, cards, and previews.</span> }
								}
								@ui.CardContent(ui.DOMProps{}) {
									<div class="grid gap-3">
										<div class="rounded-lg border border-border/70 p-3">
											<p class="text-sm font-medium">Pro Plan</p>
											<p class="text-sm text-muted-foreground">$29 / month</p>
										</div>
										@ui.Button(ui.ButtonProps{Label: "Manage", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
									</div>
								}
							}
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Invite</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Make a card feel like a useful action surface.</span> }
								}
								@ui.CardContent(ui.DOMProps{}) {
									<div class="grid gap-3">
										@ui.Input(ui.InputProps{Placeholder: "name@company.com"})
										@ui.Button(ui.ButtonProps{Label: "Send invite", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
									</div>
								}
							}
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "tasks"}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Today</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Structure the list and keep action density high.</span> }
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									<div class="flex items-center gap-3">
										@ui.Checkbox(ui.CheckboxProps{Checked: true})
										<div class="min-w-0 flex-1">
											<p class="font-medium">Finalize landing page hero</p>
											<p class="text-sm text-muted-foreground">Make the first impression feel intentional.</p>
										</div>
										@ui.Badge(ui.BadgeProps{Label: "High", Variant: ui.BadgeVariantDestructive})
									</div>
									<div class="flex items-center gap-3">
										@ui.Checkbox(ui.CheckboxProps{})
										<div class="min-w-0 flex-1">
											<p class="font-medium">Add dashboard preview cards</p>
											<p class="text-sm text-muted-foreground">Keep the component system visible.</p>
										</div>
										@ui.Badge(ui.BadgeProps{Label: "Medium", Variant: ui.BadgeVariantOutline})
									</div>
									<div class="flex items-center gap-3">
										@ui.Checkbox(ui.CheckboxProps{})
										<div class="min-w-0 flex-1">
											<p class="font-medium">Record accessibility pass</p>
											<p class="text-sm text-muted-foreground">Tab order, focus rings, and contrast.</p>
										</div>
										@ui.Badge(ui.BadgeProps{Label: "QA", Variant: ui.BadgeVariantSecondary})
									</div>
								}
							}
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Progress</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Use small visual cues to keep the page legible.</span> }
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									@ui.Progress(ui.ProgressProps{Value: 68, Max: 100})
									<div class="grid gap-2 text-sm text-muted-foreground">
										<p>8 tasks total</p>
										<p>5 complete</p>
										<p>3 remain</p>
									</div>
									@ui.Button(ui.ButtonProps{Label: "Mark complete", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
								}
							}
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "playground"}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-2">
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Playground</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Show the control surface you expect in a real app.</span> }
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									@ui.InputGroup(ui.InputGroupProps{}) {
										@ui.InputGroupAddon(ui.InputGroupAddonProps{}) { <span>https://</span> }
										@ui.InputGroupInput(ui.InputGroupInputProps{Placeholder: "example.com"}) 
										@ui.InputGroupButton(ui.InputGroupButtonProps{Size: ui.ButtonSizeSM}) { <span>Send</span> }
									}
									<div class="grid gap-2">
										@ui.Label(ui.LabelProps{For: "model"}) { <span>Model</span> }
										@ui.NativeSelect(ui.NativeSelectProps{DOMProps: ui.DOMProps{ID: "model"}}) {
											<option>Auto</option>
											<option>gpt-5.4</option>
											<option>gpt-5.4-mini</option>
										}
									</div>
									<div class="grid gap-2">
										<div class="flex items-center justify-between">
											@ui.Label(ui.LabelProps{}) { <span>Wallpaper tinting</span> }
											@ui.Switch(ui.SwitchProps{Size: "sm"})
										</div>
										@ui.Slider(ui.SliderProps{Value: []float64{52}, Max: 100})
									</div>
									<div class="flex flex-wrap gap-2">
										@ui.ToggleGroup(ui.ToggleGroupProps{Type: "single", Variant: "outline", Size: "sm"}) {
											@ui.ToggleGroupItem(ui.ToggleGroupItemProps{Value: "prompt"}) { <span>Prompt</span> }
											@ui.ToggleGroupItem(ui.ToggleGroupItemProps{Value: "all"}) { <span>All Sources</span> }
										}
									</div>
								}
							}
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Actions</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Group buttons and menus the way users expect.</span> }
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									<div class="flex flex-wrap gap-2">
										@ui.ButtonGroup(ui.ButtonGroupProps{}) {
											@ui.Button(ui.ButtonProps{Label: "Send", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
											@ui.ButtonGroupSeparator(ui.DOMProps{})
											@ui.Button(ui.ButtonProps{Label: "Archive", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
											@ui.ButtonGroupSeparator(ui.DOMProps{})
											@ui.Button(ui.ButtonProps{Label: "Snooze", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
										}
									</div>
									@ui.DropdownMenu(ui.DropdownMenuProps{}) {
										@ui.DropdownMenuTrigger(ui.DOMProps{
											Class: "inline-flex w-fit items-center rounded-md border border-border bg-background px-3 py-2 text-sm shadow-sm hover:bg-accent",
											Attrs: t.Attributes{"type": "button"},
										}) {
											<span>Prompt sources</span>
										}
										@ui.DropdownMenuContent(ui.DOMProps{Class: "mt-2 min-w-44"}) {
										@ui.DropdownMenuItem(ui.DropdownMenuItemProps{DOMProps: ui.DOMProps{Attrs: t.Attributes{"type": "button"}}}) { <span>All sources</span> }
										@ui.DropdownMenuItem(ui.DropdownMenuItemProps{DOMProps: ui.DOMProps{Attrs: t.Attributes{"type": "button"}}}) { <span>Selected files</span> }
										@ui.DropdownMenuItem(ui.DropdownMenuItemProps{DOMProps: ui.DOMProps{Attrs: t.Attributes{"type": "button"}}}) { <span>Current page</span> }
										}
									}
								}
							}
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "forms"}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Payment Method</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>All transactions are secure and encrypted.</span> }
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									@ui.Form(ui.FormProps{IDValue: "payment-form"}) {
										@ui.FormItem(ui.DOMProps{}) {
											@ui.FormLabel(ui.DOMProps{}) { <span>Name on Card</span> }
											@ui.FormControl(ui.DOMProps{}) {
												@ui.Input(ui.InputProps{Placeholder: "Jane Doe"})
											}
										}
										@ui.FormItem(ui.DOMProps{}) {
											@ui.FormLabel(ui.DOMProps{}) { <span>Billing Address</span> }
											@ui.FormControl(ui.DOMProps{}) {
												@ui.Textarea(ui.TextareaProps{Placeholder: "Street, city, state", Rows: 3})
											}
										}
										@ui.FormItem(ui.DOMProps{}) {
											<div class="flex items-center gap-2">
												@ui.Checkbox(ui.CheckboxProps{Checked: true})
												@ui.FormDescription(ui.DOMProps{}) { <span>Same as shipping address</span> }
											</div>
										}
										<div class="flex items-center justify-end gap-2">
											@ui.Button(ui.ButtonProps{Label: "Cancel", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
											@ui.Button(ui.ButtonProps{Label: "Save card", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
										</div>
									}
								}
							}
							<div class="grid gap-6">
								@ui.Alert(ui.AlertProps{Variant: ui.AlertVariantDefault}) {
									@ui.AlertTitle(ui.DOMProps{}) { <span>Your profile has been verified.</span> }
									@ui.AlertDescription(ui.DOMProps{}) { <span>Use the same field spacing and tone for every system message.</span> }
								}
								@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
									@ui.CardHeader(ui.DOMProps{}) {
										@ui.CardTitle(ui.DOMProps{}) { <span>Two-factor authentication</span> }
										@ui.CardDescription(ui.DOMProps{}) { <span>Verify via email or phone number.</span> }
									}
									@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
										@ui.InputOTP(ui.InputOTPProps{MaxLength: 6}) {
											@ui.InputOTPGroup(ui.DOMProps{}) {
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 0, Value: "1"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 1, Value: "2"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 2, Value: "3"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 3, Value: "4"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 4, Value: "5"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 5, Value: "6"})
											}
										}
										<div class="flex justify-end">
											@ui.Button(ui.ButtonProps{Label: "Enable", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
										</div>
									}
								}
							</div>
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "music"}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									<div class="flex items-center gap-4">
										@ui.Avatar(ui.AvatarProps{Size: "lg"}) {
											@ui.AvatarFallback(ui.DOMProps{}) { <span>MV</span> }
										}
										<div>
											@ui.CardTitle(ui.DOMProps{}) { <span>Playback</span> }
											@ui.CardDescription(ui.DOMProps{}) { <span>Use cards and progress bars to set the tone.</span> }
										</div>
									</div>
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									<div class="rounded-2xl bg-gradient-to-br from-primary/10 via-transparent to-transparent p-6">
										<p class="text-sm font-medium">Focus Session</p>
										<p class="text-sm text-muted-foreground">Lo-fi mix for late design passes.</p>
									</div>
									@ui.Progress(ui.ProgressProps{Value: 52, Max: 100})
									<div class="flex flex-wrap gap-2">
										@ui.Button(ui.ButtonProps{Label: "Prev", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
										@ui.Button(ui.ButtonProps{Label: "Play", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeSM, Type: "button"})
										@ui.Button(ui.ButtonProps{Label: "Next", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
									</div>
								}
							}
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{Class: "flex-row items-center justify-between space-y-0"}) {
									<div>
										@ui.CardTitle(ui.DOMProps{}) { <span>Queue</span> }
										@ui.CardDescription(ui.DOMProps{}) { <span>Small tables still read as a polished list.</span> }
									</div>
									@ui.Badge(ui.BadgeProps{Label: "Playing", Variant: ui.BadgeVariantSecondary})
								}
								@ui.CardContent(ui.DOMProps{Class: "pt-0"}) {
									@ui.Table(ui.DOMProps{}) {
										@ui.TableHeader(ui.DOMProps{}) {
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableHead(ui.DOMProps{}) { <span>Track</span> }
												@ui.TableHead(ui.DOMProps{}) { <span>Artist</span> }
												@ui.TableHead(ui.DOMProps{}) { <span>Length</span> }
											}
										}
										@ui.TableBody(ui.DOMProps{}) {
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableCell(ui.DOMProps{}) { <span>Soft Focus</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>Studio North</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>3:21</span> }
											}
											@ui.TableRow(ui.DOMProps{}) {
												@ui.TableCell(ui.DOMProps{}) { <span>Midnight Sketch</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>Ambient Loop</span> }
												@ui.TableCell(ui.DOMProps{}) { <span>4:08</span> }
											}
										}
									}
								}
							}
						</div>
					}

					@ui.TabsContent(ui.TabsContentProps{Value: "auth"}) {
						<div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
							@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
								@ui.CardHeader(ui.DOMProps{}) {
									@ui.CardTitle(ui.DOMProps{}) { <span>Sign in</span> }
									@ui.CardDescription(ui.DOMProps{}) { <span>Keep the authentication pattern restrained and clear.</span> }
								}
								@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
									@ui.Form(ui.FormProps{IDValue: "auth-form"}) {
										@ui.FormItem(ui.DOMProps{}) {
											@ui.FormLabel(ui.DOMProps{}) { <span>Email</span> }
											@ui.FormControl(ui.DOMProps{}) {
												@ui.Input(ui.InputProps{Type: "email", Placeholder: "name@company.com"})
											}
										}
										@ui.FormItem(ui.DOMProps{}) {
											@ui.FormLabel(ui.DOMProps{}) { <span>Password</span> }
											@ui.FormControl(ui.DOMProps{}) {
												@ui.Input(ui.InputProps{Type: "password", Placeholder: "••••••••"})
											}
										}
										<div class="flex items-center gap-2">
											@ui.Checkbox(ui.CheckboxProps{})
											@ui.FormDescription(ui.DOMProps{}) { <span>Remember me</span> }
										</div>
										@ui.Button(ui.ButtonProps{Label: "Continue", Variant: ui.ButtonVariantDefault, Size: ui.ButtonSizeDefault, Type: "button"})
									}
								}
							}
							<div class="grid gap-6">
								@ui.Card(ui.DOMProps{Class: "border-border/80"}) {
									@ui.CardHeader(ui.DOMProps{}) {
										@ui.CardTitle(ui.DOMProps{}) { <span>One-time code</span> }
										@ui.CardDescription(ui.DOMProps{}) { <span>Support 2FA without reaching for a client-only dependency.</span> }
									}
									@ui.CardContent(ui.DOMProps{Class: "grid gap-4"}) {
										@ui.InputOTP(ui.InputOTPProps{MaxLength: 6}) {
											@ui.InputOTPGroup(ui.DOMProps{}) {
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 0, Value: "1"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 1, Value: "9"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 2, Value: "4"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 3, Value: "2"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 4, Value: "7"})
												@ui.InputOTPSlot(ui.InputOTPSlotProps{Index: 5, Value: "5"})
											}
										}
										<div class="flex items-center justify-between">
											@ui.Badge(ui.BadgeProps{Label: "Secure", Variant: ui.BadgeVariantSecondary})
											@ui.Button(ui.ButtonProps{Label: "Verify", Variant: ui.ButtonVariantOutline, Size: ui.ButtonSizeSM, Type: "button"})
										</div>
									}
								}
							</div>
						</div>
					}
				}
			</section>

			<footer class="mx-auto flex max-w-7xl flex-col gap-4 border-t border-border/70 px-6 py-10 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
				<p>Built by <a class="underline-offset-4 hover:underline" href="https://twitter.com/shadcn">shadcn</a> at <a class="underline-offset-4 hover:underline" href="https://vercel.com">Vercel</a>.</p>
				<p>The source code is available on <a class="underline-offset-4 hover:underline" href="https://github.com/shadcn-ui/ui">GitHub</a>.</p>
			</footer>
		</main>
	}
}
